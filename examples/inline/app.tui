<tui>
  <style src="theme.tcss"/>
  <keymap>
    <bind keys="ctrl+o" action="toggle_tips" label="tips"/>
    <bind keys="ctrl+q" action="quit" label="quit"/>
  </keymap>
  <screen id="main" focus="#composer">
    <rule/>
    <textarea id="composer" bind="draft" placeholder="Message" on:submit="send"/>
    <text id="tips" class="tips" if="tips">Tips: enter sends, ctrl+o hides this line, ctrl+q quits.</text>
    <hints/>
    <text id="status">{status}</text>
  </screen>
  <template id="card" props="who">
    <text class="who">{$who}: {m.text}</text>
  </template>
</tui>
