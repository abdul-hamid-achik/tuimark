<tui theme="auto">
  <!-- The kit's tokens, then its components, then this app's own sheet last
       (a place to rebrand: re-declare any token there). -->
  <style src="../../kit/theme.tcss"/>
  <style src="../../kit/kit.tcss"/>
  <style src="app.tcss"/>

  <!-- Overlay keys come first: the first matching row in document order
       wins, and each overlay is scoped to its own component class, so a
       row fires only while focus is inside that overlay. -->
  <keymap when=".k-dialog">
    <bind keys="y" action="dialog_confirm" label="confirm"/>
    <bind keys="n" action="dialog_cancel" label="cancel"/>
  </keymap>
  <keymap when=".k-palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette__list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette__list"/>
  </keymap>
  <keymap when=".k-help">
    <bind keys="q,?" action="help_close" keycap="?" label="close help"/>
  </keymap>

  <!-- Global keys. `when="#app"` holds while focus is anywhere inside the
       app column, and not inside a modal, so the overlays keep their own
       keys. -->
  <keymap when="#app">
    <bind keys="q" action="quit" label="quit"/>
    <bind keys="?" action="help_open" label="help"/>
    <bind keys="ctrl+k" action="palette_open" keycap="^K" label="commands"/>
    <bind keys="t" action="theme_toggle" label="theme"/>
    <bind keys="1" action="switch-to" to="#basics" keycap="1-5" label="tabs"/>
    <bind keys="2" action="switch-to" to="#forms"/>
    <bind keys="3" action="switch-to" to="#data"/>
    <bind keys="4" action="switch-to" to="#overlays"/>
    <bind keys="5" action="switch-to" to="#layouts"/>
    <bind keys="]" action="move-next" to="#nav"/>
    <bind keys="[" action="move-prev" to="#nav"/>
    <bind keys="esc" action="toast_dismiss"/>
    <bind keys="backspace" action="breadcrumb_up"/>
  </keymap>
  <keymap when="#svc">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="enter" action="table_open" label="open"/>
  </keymap>
  <keymap when="#log">
    <bind keys="j" action="move-next" keycap="j/k" label="scroll"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="G" action="move-last" label="follow"/>
    <bind keys="a" action="log_append" label="append"/>
  </keymap>
  <keymap when="#prefs">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="space" action="check-toggle" label="toggle"/>
  </keymap>
  <keymap when="#items">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
  </keymap>

  <screen id="gallery" focus="#nav">
    <col id="app" width="1fr" height="1fr">
      <!-- app bar -->
      <row class="k-appbar">
        <text class="k-appbar-brand">◆ tuimark kit</text>
        <text class="k-appbar-title">component gallery</text>
        <spacer/>
        <text class="k-appbar-meta">press t to switch the theme</text>
        <text class="k-badge accent">v0</text>
      </row>

      <tabs id="nav" class="k-tabs" bind="view" mark="▸" focusable="true">
        <!-- ============================================================ -->
        <tab id="basics" label="1 basics" short="1 bas">
          <scroll id="basics__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <row class="k-breadcrumb" each="crumbs as c" key="c.id">
                <text class="k-breadcrumb-item" class:current="c.last">{c.label}</text>
                <text class="k-breadcrumb-sep" if="!c.last">›</text>
              </row>
              <row class="k-cols">
                <box class="k-card" title="Badges">
                  <row class="k-card-row">
                    <text class="k-badge">draft</text>
                    <text class="k-badge accent">new</text>
                    <text class="k-badge ok">passing</text>
                  </row>
                  <row class="k-card-row">
                    <text class="k-badge warn">flaky</text>
                    <text class="k-badge danger">failed</text>
                    <text class="k-badge info">#1842</text>
                  </row>
                </box>
                <box class="k-card" title="Buttons">
                  <row class="k-card-actions">
                    <button id="buttons__primary" class="k-btn primary" label="Save" on:click="button_press"/>
                    <button id="buttons__secondary" class="k-btn secondary" label="Cancel" on:click="button_press"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="buttons__danger" class="k-btn danger" label="Delete" on:click="button_press"/>
                    <button id="buttons__ghost" class="k-btn ghost" label="Skip" on:click="button_press"/>
                    <button id="buttons__off" class="k-btn secondary" label="Locked" disabled="true"/>
                  </row>
                </box>
              </row>
              <row class="k-cols">
                <box class="k-alert info" title="Heads up">
                  <row class="k-alert-row">
                    <text class="k-alert-icon info">i</text>
                    <text class="k-alert-text">Deploys are paused until 09:00 UTC.</text>
                  </row>
                </box>
                <box class="k-alert ok" title="Saved">
                  <row class="k-alert-row">
                    <text class="k-alert-icon ok">✓</text>
                    <text class="k-alert-text">Your changes are live everywhere.</text>
                  </row>
                </box>
              </row>
              <row class="k-cols">
                <box class="k-alert warn" title="Quota">
                  <row class="k-alert-row">
                    <text class="k-alert-icon warn">!</text>
                    <text class="k-alert-text">92% of this month's build minutes used.</text>
                  </row>
                </box>
                <box class="k-alert danger" title="Build failed">
                  <row class="k-alert-row">
                    <text class="k-alert-icon danger">✗</text>
                    <text class="k-alert-text">Step 3 exited with code 1.</text>
                  </row>
                </box>
              </row>
              <row class="k-cols">
                <box class="k-stat" title="Requests">
                  <text class="k-stat-value">{stats.req.value}</text>
                  <row class="k-stat-row">
                    <text class="k-stat-delta" class:good="stats.req.good" class:bad="!stats.req.good">{stats.req.delta}</text>
                    <sparkline class="k-stat-spark" bind="stats.req.hist"/>
                  </row>
                </box>
                <box class="k-stat" title="Errors">
                  <text class="k-stat-value">{stats.err.value}</text>
                  <row class="k-stat-row">
                    <text class="k-stat-delta" class:good="stats.err.good" class:bad="!stats.err.good">{stats.err.delta}</text>
                    <sparkline class="k-stat-spark" bind="stats.err.hist"/>
                  </row>
                </box>
              </row>
              <box class="k-card" title="Progress">
                <col class="k-meter">
                  <row class="k-meter-head">
                    <text class="k-meter-label">Upload</text>
                    <spacer/>
                    <text class="k-meter-value">{meters.upload.text}</text>
                  </row>
                  <progress class="k-meter-bar" bind="meters.upload.pct"/>
                </col>
                <col class="k-meter">
                  <row class="k-meter-head">
                    <text class="k-meter-label">Disk</text>
                    <spacer/>
                    <text class="k-meter-value">{meters.disk.text}</text>
                  </row>
                  <progress class="k-meter-bar" class:warn="meters.disk.warn" class:danger="meters.disk.crit" bind="meters.disk.pct"/>
                </col>
                <col class="k-meter">
                  <row class="k-meter-head">
                    <text class="k-meter-label">Tests</text>
                    <spacer/>
                    <text class="k-meter-value">{meters.tests.text}</text>
                  </row>
                  <progress class="k-meter-bar ok" bind="meters.tests.pct"/>
                </col>
              </box>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="forms" label="2 forms" short="2 frm">
          <scroll id="forms__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <row class="k-cols">
                <box class="k-card" title="Profile">
                  <col class="k-field">
                    <text class="k-field-label" class:invalid="forms.profile.name.error">Name</text>
                    <input id="profile__name" class="k-field-input" class:invalid="forms.profile.name.error" bind="forms.profile.name.value" placeholder="your name" on:change="form_validate" on:submit="form_submit"/>
                    <text class="k-field-help" if="!forms.profile.name.error">Shown on your profile.</text>
                    <text class="k-field-error" if="forms.profile.name.error">{forms.profile.name.error}</text>
                  </col>
                  <col class="k-field">
                    <text class="k-field-label" class:invalid="forms.profile.email.error">Email</text>
                    <input id="profile__email" class="k-field-input" class:invalid="forms.profile.email.error" bind="forms.profile.email.value" placeholder="you@example.com" on:change="form_validate" on:submit="form_submit"/>
                    <text class="k-field-help" if="!forms.profile.email.error">We never share it.</text>
                    <text class="k-field-error" if="forms.profile.email.error">{forms.profile.email.error}</text>
                  </col>
                  <row class="k-card-actions">
                    <button id="profile__save" class="k-btn primary" label="Save" on:click="form_submit"/>
                    <button id="profile__reset" class="k-btn ghost" label="Reset" on:click="button_press"/>
                  </row>
                </box>
                <list id="prefs" class="k-menu" each="prefs as p" key="p.id" bind="prefs_cur" checked="prefs_on" mark="✓" title="Notify me by" on:change="menu_change">
                  <item>
                    <row class="k-menu-row">
                      <text class="k-menu-icon">{p.icon}</text>
                      <text class="k-menu-label">{p.label}</text>
                      <text class="k-menu-key">{p.note}</text>
                    </row>
                  </item>
                </list>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="data" label="3 data" short="3 dat">
          <scroll id="data__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <table id="svc" class="k-table" each="svc.rows as s" key="s.id" bind="svc.cur" title="Services · {svc.count}" placeholder="no services" on:select="table_select">
                <column id="svc__name" class="k-table-name" title="SERVICE" width="1fr">{s.name}</column>
                <column id="svc__state" class="k-table-state" class:ok="s.ok" class:danger="!s.ok" title="STATE" width="9">{s.state}</column>
                <column id="svc__region" class="k-table-muted" title="REGION" width="10" priority="1">{s.region}</column>
                <column id="svc__rps" class="k-num" title="REQ/S" width="8" priority="2">{s.rps}</column>
                <column id="svc__p95" class="k-num" title="P95 MS" width="8" priority="3">{s.p95}</column>
              </table>
              <row class="k-cols">
                <scroll id="log" class="k-log" stick="bottom" focusable="true" title="build log · {log.count} lines">
                  <col class="k-log-lines" each="log.lines as l" key="l.n">
                    <text class="k-log-line" class:muted="l.debug" class:info="l.info" class:warn="l.warn" class:danger="l.err">{l.text}</text>
                  </col>
                </scroll>
                <box id="empty__card" class="k-card" title="Empty state">
                  <col class="k-empty">
                    <text class="k-empty-icon">◌</text>
                    <text class="k-empty-title">No deployments yet</text>
                    <text class="k-empty-text">Push a commit or create one.</text>
                    <button id="empty__create" class="k-btn primary" label="New deployment" on:click="empty_create"/>
                  </col>
                </box>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="overlays" label="4 overlays" short="4 ovl">
          <scroll id="overlays__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <row class="k-cols">
                <box class="k-card" title="Dialogs">
                  <text class="k-card-muted">A modal opens over the page; esc closes it.</text>
                  <row class="k-card-actions">
                    <button id="confirm__open" class="k-btn danger" label="Delete project…" on:click="dialog_open"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="palette__open" class="k-btn secondary" label="Commands" on:click="palette_open"/>
                    <button id="help__open" class="k-btn ghost" label="Help" on:click="help_open"/>
                  </row>
                </box>
                <box class="k-card" title="Toasts">
                  <text class="k-card-muted">A toast clears itself after a few seconds.</text>
                  <row class="k-card-actions">
                    <button id="toast__info" class="k-btn secondary" label="Info" on:click="toast_show"/>
                    <button id="toast__ok" class="k-btn secondary" label="Success" on:click="toast_show"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="toast__warn" class="k-btn secondary" label="Warning" on:click="toast_show"/>
                    <button id="toast__danger" class="k-btn secondary" label="Danger" on:click="toast_show"/>
                  </row>
                </box>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="layouts" label="5 layouts" short="5 lay">
          <row class="k-split">
            <list id="items" class="k-menu k-split-master" each="split.items as it" key="it.id" bind="split.cur" title="Incidents" on:select="menu_select">
              <item>
                <row class="k-menu-row">
                  <text class="k-menu-label">{it.title}</text>
                  <text class="k-menu-key">{it.age}</text>
                </row>
              </item>
            </list>
            <box class="k-card k-split-detail" title="{detail.title}">
              <row class="k-card-row">
                <text class="k-badge" class:danger="detail.open" class:ok="!detail.open">{detail.status}</text>
                <text class="k-muted">{detail.age} ago</text>
              </row>
              <text class="k-card-text" wrap="wrap">{detail.summary}</text>
              <text class="k-card-muted">owner: {detail.owner}</text>
            </box>
          </row>
        </tab>
      </tabs>

      <hints class="k-hints"/>

      <!-- toast: always one row, so nothing jumps when it appears -->
      <row class="k-toast-slot">
        <row class="k-toast" if="toast.show" class:ok="toast.is_ok" class:warn="toast.is_warn" class:danger="toast.is_danger">
          <text class="k-toast-text">{toast.text}</text>
          <text class="k-toast-key">esc</text>
        </row>
      </row>

      <!-- status bar, docked to the bottom -->
      <row class="k-statusbar">
        <text class="k-statusbar-seg">GALLERY</text>
        <text class="k-statusbar-text">{status.text}</text>
        <spacer/>
        <text class="k-statusbar-muted">{status.right}</text>
      </row>
    </col>

    <!-- modals: always the last children of the screen -->
    <modal id="confirm__dialog" class="k-dialog danger" open="confirm.open" title="{confirm.title}" focus="#confirm__no" on:escape="dialog_cancel">
      <text class="k-dialog-text">{confirm.message}</text>
      <row class="k-dialog-actions">
        <spacer/>
        <button id="confirm__no" class="k-btn secondary" label="Cancel" on:click="dialog_cancel"/>
        <button id="confirm__yes" class="k-btn danger" label="Delete" on:click="dialog_confirm"/>
      </row>
    </modal>

    <modal id="palette__dialog" class="k-palette" open="palette.open" title="Command palette" focus="#palette__q" on:escape="palette_close">
      <input id="palette__q" class="k-palette-input" bind="palette.query" placeholder="type a command…" on:change="palette_query" on:submit="palette_run"/>
      <text class="k-palette-empty" if="!found.any">No command matches “{palette.query}”.</text>
      <list id="palette__list" class="k-palette-list" each="found.items as r" key="r.id" bind="palette.cur" focusable="false">
        <item>
          <row class="k-palette-row">
            <text class="k-palette-label">{r.label}</text>
            <text class="k-palette-hint">{r.hint}</text>
          </row>
        </item>
      </list>
    </modal>

    <modal id="help__dialog" class="k-help" open="help.open" title="Keys" on:escape="help_close">
      <hints class="k-hints k-help-keys" scope="all"/>
    </modal>
  </screen>
</tui>
