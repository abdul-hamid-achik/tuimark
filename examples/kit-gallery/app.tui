<tui theme="auto">
  <!-- The kit first: its sheets (tokens, then component classes), the keys
       of its overlays (y/n in a dialog, q/? in the help), and its
       templates. Then this app's own sheet, last (a place to rebrand:
       re-declare any token there). -->
  <include src="../../kit/kit.tui"/>
  <style src="app.tcss"/>

  <!-- Overlay keys come first: the first matching row in document order
       wins, and each overlay is scoped to its own component class, so a
       row fires only while focus is inside that overlay. The kit's own
       overlay rows came with the include, before these. The palette's
       arrows name its list, palette__list, so they live here, in the
       document that uses the palette as `palette`. -->
  <keymap when=".k-palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette__list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette__list"/>
  </keymap>

  <!-- Global keys. `when="#app"` holds while focus is anywhere inside the
       app column, and not inside a modal, so the overlays keep their own
       keys. -->
  <keymap when="#app">
    <bind keys="q" action="quit" label="quit"/>
    <bind keys="?" action="help_open" label="help"/>
    <bind keys="ctrl+k" action="palette_open" keycap="^K" label="commands"/>
    <bind keys="t" action="theme_toggle" label="theme"/>
    <bind keys="1" action="switch-to" to="#basics" keycap="1-5" label="tabs"/>
    <bind keys="2" action="switch-to" to="#forms"/>
    <bind keys="3" action="switch-to" to="#data"/>
    <bind keys="4" action="switch-to" to="#overlays"/>
    <bind keys="5" action="switch-to" to="#layouts"/>
    <bind keys="]" action="move-next" to="#nav"/>
    <bind keys="[" action="move-prev" to="#nav"/>
    <bind keys="esc" action="toast_dismiss"/>
    <bind keys="backspace" action="breadcrumb_up"/>
  </keymap>
  <keymap when="#svc">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="enter" action="table_open" label="open"/>
  </keymap>
  <keymap when="#log__view">
    <bind keys="j" action="move-next" keycap="j/k" label="scroll"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="G" action="move-last" label="follow"/>
    <bind keys="a" action="log_append" label="append"/>
  </keymap>
  <keymap when="#prefs">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="space" action="check-toggle" label="toggle"/>
  </keymap>
  <keymap when="#items">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
  </keymap>

  <screen id="gallery" focus="#nav">
    <col id="app" width="1fr" height="1fr">
      <!-- app bar -->
      <use template="k-appbar" brand="◆ tuimark kit" title="component gallery">
        <text class="k-appbar-meta">press t to switch the theme</text>
        <text class="k-badge accent">v2</text>
      </use>

      <tabs id="nav" class="k-tabs" bind="view" mark="▸" focusable="true">
        <!-- ============================================================ -->
        <tab id="basics" label="1 basics" short="1 bas">
          <scroll id="basics__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <use template="k-breadcrumb" with="crumbs as b"/>
              <row class="k-cols">
                <use template="k-card" title="Badges">
                  <row class="k-card-row">
                    <text class="k-badge">draft</text>
                    <text class="k-badge accent">new</text>
                    <text class="k-badge ok">passing</text>
                  </row>
                  <row class="k-card-row">
                    <text class="k-badge warn">flaky</text>
                    <text class="k-badge danger">failed</text>
                    <text class="k-badge info">#1842</text>
                  </row>
                </use>
                <use template="k-card" title="Buttons">
                  <row class="k-card-actions">
                    <button id="buttons__primary" class="k-btn primary" label="Save" on:click="button_press"/>
                    <button id="buttons__secondary" class="k-btn secondary" label="Cancel" on:click="button_press"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="buttons__danger" class="k-btn danger" label="Delete" on:click="button_press"/>
                    <button id="buttons__ghost" class="k-btn ghost" label="Skip" on:click="button_press"/>
                    <button id="buttons__off" class="k-btn secondary" label="Locked" disabled="true"/>
                  </row>
                </use>
              </row>
              <row class="k-cols">
                <use template="k-alert" class="info" title="Heads up" icon="i" text="Deploys are paused until 09:00 UTC."/>
                <use template="k-alert" class="ok" title="Saved" icon="✓" text="Your changes are live everywhere."/>
              </row>
              <row class="k-cols">
                <use template="k-alert" class="warn" title="Quota" icon="!" text="92% of this month's build minutes used."/>
                <use template="k-alert" class="danger" title="Build failed" icon="✗" text="Step 3 exited with code 1."/>
              </row>
              <row class="k-cols">
                <use template="k-stat" title="Requests" with="stats.req as s"/>
                <use template="k-stat" title="Errors" with="stats.err as s"/>
              </row>
              <use template="k-card" title="Progress">
                <use template="k-meter" label="Upload" with="meters.upload as m"/>
                <use template="k-meter" label="Disk" with="meters.disk as m"/>
                <use template="k-meter" class="ok" label="Tests" with="meters.tests as m"/>
              </use>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="forms" label="2 forms" short="2 frm">
          <scroll id="forms__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <row class="k-cols">
                <use template="k-card" title="Profile">
                  <use id="profile__name" template="k-field" label="Name" placeholder="your name" help="Shown on your profile." with="forms.profile.name as f"/>
                  <use id="profile__email" template="k-field" label="Email" placeholder="you@example.com" help="We never share it." with="forms.profile.email as f"/>
                  <row class="k-card-actions">
                    <button id="profile__save" class="k-btn primary" label="Save" on:click="form_submit"/>
                    <button id="profile__reset" class="k-btn ghost" label="Reset" on:click="button_press"/>
                  </row>
                </use>
                <list id="prefs" class="k-menu" each="prefs as p" key="p.id" bind="prefs_cur" checked="prefs_on" mark="✓" title="Notify me by" on:change="menu_change">
                  <item>
                    <row class="k-menu-row">
                      <text class="k-menu-icon">{p.icon}</text>
                      <text class="k-menu-label">{p.label}</text>
                      <text class="k-menu-key">{p.note}</text>
                    </row>
                  </item>
                </list>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="data" label="3 data" short="3 dat">
          <scroll id="data__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <table id="svc" class="k-table" each="svc.rows as s" key="s.id" bind="svc.cur" title="Services · {svc.count}" placeholder="no services" on:select="table_select">
                <column id="svc__name" class="k-table-name" title="SERVICE" width="1fr">{s.name}</column>
                <column id="svc__state" class="k-table-state" class:ok="s.ok" class:danger="!s.ok" title="STATE" width="9">{s.state}</column>
                <column id="svc__region" class="k-table-muted" title="REGION" width="10" priority="1">{s.region}</column>
                <column id="svc__rps" class="k-num" title="REQ/S" width="8" priority="2">{s.rps}</column>
                <column id="svc__p95" class="k-num" title="P95 MS" width="8" priority="3">{s.p95}</column>
              </table>
              <row class="k-cols">
                <use id="log" template="k-log" with="log as l"/>
                <use template="k-card" title="Empty state" style="height: 10">
                  <use template="k-empty" icon="◌" title="No deployments yet" text="Push a commit or create one.">
                    <button id="empty__create" class="k-btn primary" label="New deployment" on:click="empty_create"/>
                  </use>
                </use>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="overlays" label="4 overlays" short="4 ovl">
          <scroll id="overlays__page" class="k-page" focusable="true">
            <col class="k-page-body">
              <row class="k-cols">
                <use template="k-card" title="Dialogs">
                  <text class="k-card-muted">A modal opens over the page; esc closes it.</text>
                  <row class="k-card-actions">
                    <button id="confirm__open" class="k-btn danger" label="Delete project…" on:click="dialog_open"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="palette__open" class="k-btn secondary" label="Commands" on:click="palette_open"/>
                    <button id="help__open" class="k-btn ghost" label="Help" on:click="help_open"/>
                  </row>
                </use>
                <use template="k-card" title="Toasts">
                  <text class="k-card-muted">A toast clears itself after a few seconds.</text>
                  <row class="k-card-actions">
                    <button id="toast__info" class="k-btn secondary" label="Info" on:click="toast_show"/>
                    <button id="toast__ok" class="k-btn secondary" label="Success" on:click="toast_show"/>
                  </row>
                  <row class="k-card-actions">
                    <button id="toast__warn" class="k-btn secondary" label="Warning" on:click="toast_show"/>
                    <button id="toast__danger" class="k-btn secondary" label="Danger" on:click="toast_show"/>
                  </row>
                </use>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="layouts" label="5 layouts" short="5 lay">
          <row class="k-split">
            <list id="items" class="k-menu k-split-master" each="split.items as it" key="it.id" bind="split.cur" title="Incidents" on:select="menu_select">
              <item>
                <row class="k-menu-row">
                  <text class="k-menu-label">{it.title}</text>
                  <text class="k-menu-key">{it.age}</text>
                </row>
              </item>
            </list>
            <box class="k-card k-split-detail" title="{detail.title}">
              <row class="k-card-row">
                <text class="k-badge" class:danger="detail.open" class:ok="!detail.open">{detail.status}</text>
                <text class="k-muted">{detail.age} ago</text>
              </row>
              <text class="k-card-text" wrap="wrap">{detail.summary}</text>
              <use template="k-kv" label="Owner" with="detail.owner as v"/>
            </box>
          </row>
        </tab>
      </tabs>

      <hints class="k-hints"/>

      <!-- toast: always one row, so nothing jumps when it appears -->
      <use template="k-toast" with="toast as t"/>

      <!-- status bar, docked to the bottom -->
      <row class="k-statusbar">
        <text class="k-statusbar-seg">GALLERY</text>
        <text class="k-statusbar-text">{status.text}</text>
        <spacer/>
        <text class="k-statusbar-muted">{status.right}</text>
      </row>
    </col>

    <!-- modals: always the last children of the screen. A use id is the
         instance the handlers route by: confirm__no and confirm__yes belong
         to `confirm`, whose state is under confirm. -->
    <use id="confirm" template="k-confirm" class="danger" with="confirm as d"/>
    <use id="palette" template="k-palette" title="Command palette" placeholder="type a command…" with="palette as p, found as f"/>
    <use id="help" template="k-help" title="Keys" with="help as h"/>
  </screen>
</tui>
