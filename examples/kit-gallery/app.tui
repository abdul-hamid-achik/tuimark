<tui version="3" theme="auto">
  <!-- Tokens first, then the components, then this app's own overrides. -->
  <style src="../../kit/theme.tcss"/>
  <style src="../../kit/kit.tcss"/>
  <style src="app.tcss"/>

  <!-- Global keys. `when="#app"` holds while focus is anywhere inside the app
       column, and not inside a modal, so the dialogs keep their own keys. -->
  <keymap when="#app">
    <bind keys="q" action="quit" label="quit"/>
    <bind keys="?" action="help_open" label="help"/>
    <bind keys="ctrl+k" action="palette_open" keycap="^K" label="commands"/>
    <bind keys="t" action="theme_toggle" label="theme"/>
    <bind keys="1" action="switch-to" to="#basics" keycap="1-5" label="tabs"/>
    <bind keys="2" action="switch-to" to="#forms"/>
    <bind keys="3" action="switch-to" to="#data"/>
    <bind keys="4" action="switch-to" to="#overlays"/>
    <bind keys="5" action="switch-to" to="#layouts"/>
    <bind keys="]" action="move-next" to="#nav"/>
    <bind keys="[" action="move-prev" to="#nav"/>
    <bind keys="esc" action="toast_dismiss"/>
    <bind keys="backspace" action="crumb_up"/>
  </keymap>
  <keymap when="#svc">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="enter" action="svc_open" label="open"/>
  </keymap>
  <keymap when="#log">
    <bind keys="j" action="move-next" keycap="j/k" label="scroll"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="G" action="move-last" label="follow"/>
    <bind keys="a" action="log_append" label="append"/>
  </keymap>
  <keymap when="#prefs">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="space" action="check-toggle" label="toggle"/>
  </keymap>
  <keymap when="#items">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
  </keymap>
  <keymap when="#confirm">
    <bind keys="y" action="confirm_accept"/>
    <bind keys="n" action="confirm_cancel"/>
  </keymap>
  <keymap when="#palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette-list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette-list"/>
  </keymap>
  <keymap when="#help">
    <bind keys="q,?" action="help_close" keycap="?" label="close help"/>
  </keymap>

  <screen id="gallery" focus="#nav">
    <col id="app" width="1fr" height="1fr">
      <!-- app bar -->
      <row class="appbar">
        <text class="appbar-brand">◆ tuimark kit</text>
        <text class="appbar-title">component gallery</text>
        <spacer/>
        <text class="appbar-meta">{theme.name} theme</text>
        <text class="badge accent">v0</text>
      </row>

      <tabs id="nav" class="tabs" bind="view" mark="▸" focusable="true">
        <!-- ============================================================ -->
        <tab id="basics" label="1 basics" short="1 bas">
          <scroll id="p-basics" class="page" focusable="true">
            <col class="page-body">
              <row class="crumbs" each="crumbs as c" key="c.id">
                <text class="crumb" class:current="c.last">{c.label}</text>
                <text class="crumb-sep" if="!c.last">›</text>
              </row>
              <row class="cols">
                <box class="card" title="Badges">
                  <row class="btn-row">
                    <text class="badge">draft</text>
                    <text class="badge accent">new</text>
                    <text class="badge success">passing</text>
                  </row>
                  <row class="btn-row">
                    <text class="badge warning">flaky</text>
                    <text class="badge danger">failed</text>
                    <text class="badge info">#1842</text>
                  </row>
                </box>
                <box class="card" title="Buttons">
                  <row class="btn-row">
                    <button id="b-primary" class="btn primary" label="Save" on:click="demo_press"/>
                    <button id="b-secondary" class="btn secondary" label="Cancel" on:click="demo_press"/>
                  </row>
                  <row class="btn-row">
                    <button id="b-danger" class="btn danger" label="Delete" on:click="demo_press"/>
                    <button id="b-ghost" class="btn ghost" label="Skip" on:click="demo_press"/>
                    <button id="b-off" class="btn secondary" label="Locked" disabled="true"/>
                  </row>
                </box>
              </row>
              <row class="cols">
                <box class="alert info" title="Heads up">
                  <row class="alert-row">
                    <text class="alert-icon info">i</text>
                    <text class="alert-text">Deploys are paused until 09:00 UTC.</text>
                  </row>
                </box>
                <box class="alert success" title="Saved">
                  <row class="alert-row">
                    <text class="alert-icon success">✓</text>
                    <text class="alert-text">Your changes are live everywhere.</text>
                  </row>
                </box>
              </row>
              <row class="cols">
                <box class="alert warning" title="Quota">
                  <row class="alert-row">
                    <text class="alert-icon warning">!</text>
                    <text class="alert-text">92% of this month's build minutes used.</text>
                  </row>
                </box>
                <box class="alert danger" title="Build failed">
                  <row class="alert-row">
                    <text class="alert-icon danger">✗</text>
                    <text class="alert-text">Step 3 exited with code 1.</text>
                  </row>
                </box>
              </row>
              <row class="cols">
                <box class="stat" title="Requests">
                  <text class="stat-value">{stats.req.value}</text>
                  <row class="stat-row">
                    <text class="stat-delta" class:good="stats.req.good" class:bad="!stats.req.good">{stats.req.delta}</text>
                    <sparkline class="stat-spark" bind="stats.req.hist"/>
                  </row>
                </box>
                <box class="stat" title="Errors">
                  <text class="stat-value">{stats.err.value}</text>
                  <row class="stat-row">
                    <text class="stat-delta" class:good="stats.err.good" class:bad="!stats.err.good">{stats.err.delta}</text>
                    <sparkline class="stat-spark" bind="stats.err.hist"/>
                  </row>
                </box>
              </row>
              <box class="card" title="Progress">
                <col class="meter">
                  <row class="meter-head">
                    <text class="meter-label">Upload</text>
                    <spacer/>
                    <text class="meter-value">{meters.upload.text}</text>
                  </row>
                  <progress class="meter-bar" bind="meters.upload.pct"/>
                </col>
                <col class="meter">
                  <row class="meter-head">
                    <text class="meter-label">Disk</text>
                    <spacer/>
                    <text class="meter-value">{meters.disk.text}</text>
                  </row>
                  <progress class="meter-bar" class:warning="meters.disk.warn" class:danger="meters.disk.crit" bind="meters.disk.pct"/>
                </col>
                <col class="meter">
                  <row class="meter-head">
                    <text class="meter-label">Tests</text>
                    <spacer/>
                    <text class="meter-value">{meters.tests.text}</text>
                  </row>
                  <progress class="meter-bar success" bind="meters.tests.pct"/>
                </col>
              </box>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="forms" label="2 forms" short="2 frm">
          <scroll id="p-forms" class="page" focusable="true">
            <col class="page-body">
              <row class="cols">
                <box class="card" title="Profile">
                  <col class="field">
                    <text class="field-label" class:invalid="form.name_error">Name</text>
                    <input id="f-name" class="field-input" class:invalid="form.name_error" bind="form.name" placeholder="your name" on:change="form_validate" on:submit="form_submit"/>
                    <text class="field-help" if="!form.name_error">Shown on your profile.</text>
                    <text class="field-error" if="form.name_error">{form.name_error}</text>
                  </col>
                  <col class="field">
                    <text class="field-label" class:invalid="form.email_error">Email</text>
                    <input id="f-email" class="field-input" class:invalid="form.email_error" bind="form.email" placeholder="you@example.com" on:change="form_validate" on:submit="form_submit"/>
                    <text class="field-help" if="!form.email_error">We never share it.</text>
                    <text class="field-error" if="form.email_error">{form.email_error}</text>
                  </col>
                  <row class="btn-row">
                    <button id="f-save" class="btn primary" label="Save" on:click="form_submit"/>
                    <button id="f-cancel" class="btn ghost" label="Reset" on:click="demo_press"/>
                  </row>
                </box>
                <list id="prefs" class="menu menu-fixed" each="prefs as p" key="p.id" bind="prefs_cur" checked="prefs_on" mark="✓" title="Notify me by" on:change="prefs_change">
                  <item>
                    <row class="menu-row">
                      <text class="menu-icon">{p.icon}</text>
                      <text class="menu-label">{p.label}</text>
                      <text class="menu-key">{p.note}</text>
                    </row>
                  </item>
                </list>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="data" label="3 data" short="3 dat">
          <scroll id="p-data" class="page" focusable="true">
            <col class="page-body">
              <table id="svc" class="dtable" each="svc.rows as s" key="s.id" bind="svc.cur" title="Services · {svc.count}" placeholder="no services" on:select="svc_select">
                <column id="c-name" class="cell-name" title="SERVICE" width="1fr">{s.name}</column>
                <column id="c-state" title="STATE" width="9" class:cell-success="s.ok" class:cell-danger="!s.ok">{s.state}</column>
                <column id="c-region" class="cell-muted" title="REGION" width="10" priority="1">{s.region}</column>
                <column id="c-rps" class="num" title="REQ/S" width="8" priority="2">{s.rps}</column>
                <column id="c-p95" class="num" title="P95 MS" width="8" priority="3">{s.p95}</column>
              </table>
              <row class="cols">
                <scroll id="log" class="logpanel" stick="bottom" focusable="true" title="build log · {log.count} lines">
                  <col class="log-lines" each="log.lines as l" key="l.n">
                    <text class="log-line" class:muted="l.debug" class:info="l.info" class:warning="l.warn" class:danger="l.err">{l.text}</text>
                  </col>
                </scroll>
                <box class="card empty-card" title="Empty state">
                  <col class="empty">
                    <text class="empty-icon">◌</text>
                    <text class="empty-title">No deployments yet</text>
                    <text class="empty-text">Push a commit or create one.</text>
                    <button id="create" class="btn primary" label="New deployment" on:click="empty_create"/>
                  </col>
                </box>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="overlays" label="4 overlays" short="4 ovl">
          <scroll id="p-overlays" class="page" focusable="true">
            <col class="page-body">
              <row class="cols">
                <box class="card" title="Dialogs">
                  <text class="card-muted">A modal opens over the page; esc closes it.</text>
                  <row class="btn-row">
                    <button id="o-confirm" class="btn danger" label="Delete project…" on:click="confirm_open"/>
                  </row>
                  <row class="btn-row">
                    <button id="o-palette" class="btn secondary" label="Commands" on:click="palette_open"/>
                    <button id="o-help" class="btn ghost" label="Help" on:click="help_open"/>
                  </row>
                </box>
                <box class="card" title="Toasts">
                  <text class="card-muted">A toast clears itself after a few seconds.</text>
                  <row class="btn-row">
                    <button id="t-info" class="btn secondary" label="Info" on:click="toast_show"/>
                    <button id="t-success" class="btn secondary" label="Success" on:click="toast_show"/>
                  </row>
                  <row class="btn-row">
                    <button id="t-warning" class="btn secondary" label="Warning" on:click="toast_show"/>
                    <button id="t-danger" class="btn secondary" label="Danger" on:click="toast_show"/>
                  </row>
                </box>
              </row>
            </col>
          </scroll>
        </tab>

        <!-- ============================================================ -->
        <tab id="layouts" label="5 layouts" short="5 lay">
          <row class="split">
            <list id="items" class="menu split-master" each="split.items as it" key="it.id" bind="split.cur" title="Incidents" on:select="item_select">
              <item>
                <row class="menu-row">
                  <text class="menu-label">{it.title}</text>
                  <text class="menu-key">{it.age}</text>
                </row>
              </item>
            </list>
            <box class="card split-detail" title="{detail.title}">
              <row class="btn-row">
                <text class="badge" class:danger="detail.open" class:success="!detail.open">{detail.status}</text>
                <text class="muted">{detail.age} ago</text>
              </row>
              <text class="card-text" wrap="wrap">{detail.summary}</text>
              <text class="card-muted">owner: {detail.owner}</text>
            </box>
          </row>
        </tab>
      </tabs>

      <hints class="hintbar"/>

      <!-- toast: always one row, so nothing jumps when it appears -->
      <row class="toast-slot">
        <row class="toast" if="toast.show" class:success="toast.is_success" class:warning="toast.is_warning" class:danger="toast.is_danger">
          <text class="toast-text">{toast.text}</text>
          <text class="toast-key">esc</text>
        </row>
      </row>

      <!-- status bar, docked to the bottom -->
      <row class="statusbar">
        <text class="statusbar-seg">GALLERY</text>
        <text class="statusbar-text">{status.text}</text>
        <spacer/>
        <text class="statusbar-muted">{status.right}</text>
      </row>
    </col>

    <!-- modals: always the last children of the screen -->
    <modal id="confirm" class="dialog danger" open="confirm.open" title="{confirm.title}" focus="#confirm-no" on:escape="confirm_cancel">
      <text class="dialog-text">{confirm.message}</text>
      <row class="dialog-actions">
        <spacer/>
        <button id="confirm-no" class="btn secondary" label="Cancel" on:click="confirm_cancel"/>
        <button id="confirm-yes" class="btn danger" label="Delete" on:click="confirm_accept"/>
      </row>
    </modal>

    <modal id="palette" class="palette" open="palette.open" title="Command palette" focus="#palette-input" on:escape="palette_close">
      <input id="palette-input" class="palette-input" bind="palette.query" placeholder="type a command…" on:submit="palette_run"/>
      <text class="empty-text" if="!found.any">No command matches “{palette.query}”.</text>
      <list id="palette-list" class="palette-list" each="found.items as r" key="r.id" bind="palette.cur" focusable="false">
        <item>
          <row class="palette-row">
            <text class="palette-label">{r.label}</text>
            <text class="palette-hint">{r.hint}</text>
          </row>
        </item>
      </list>
    </modal>

    <modal id="help" class="help" open="help.open" title="Keys" on:escape="help_close">
      <hints class="help-keys" scope="all"/>
    </modal>
  </screen>
</tui>
