/*
 * The gallery's own sheet, loaded after the kit. It holds only what is
 * specific to this page: sizes the kit leaves to the app (a viewport inside
 * a scrolling page needs a height of its own). Re-declare a token here
 * (`:root { --accent: ... }`) to rebrand the whole kit.
 */

/* Viewports inside a scrolling page cannot be 1fr tall: give them rows. */
#svc { height: 9; }
#log__view { height: 10; }
#empty__card { height: 10; }
#prefs { height: 6; }

/* The master list of the layouts tab fills its tab. */
#items { height: 1fr; }

/* The version badge is the first thing to go on a narrow terminal. */
@media (max-cols: 60) {
  .k-appbar > .k-badge { display: none; }
}
