<tui theme="auto" mouse="mouse">
  <style src="theme.tcss"/>
  <keymap when="#help">
    <bind keys="enter,q,?" action="help_close"/>
  </keymap>
  <keymap>
    <bind keys="?" action="help_open" label="help"/>
    <bind keys="q" action="quit" label="quit"/>
    <bind keys="ctrl+c" action="quit"/>
  </keymap>
  <!-- A modal traps the keymap: q quits from the new game and solved
       modals too (in the help, the row above closes it first). -->
  <keymap when="modal">
    <bind keys="q" action="quit" label="quit"/>
  </keymap>
  <keymap when="#board">
    <bind keys="up,k" action="up" keycap="↑↓←→" label="move"/>
    <bind keys="down,j" action="down"/>
    <bind keys="left,h" action="left"/>
    <bind keys="right,l" action="right"/>
    <bind keys="1" action="put1" keycap="1-9" label="digit"/>
    <bind keys="2" action="put2"/>
    <bind keys="3" action="put3"/>
    <bind keys="4" action="put4"/>
    <bind keys="5" action="put5"/>
    <bind keys="6" action="put6"/>
    <bind keys="7" action="put7"/>
    <bind keys="8" action="put8"/>
    <bind keys="9" action="put9"/>
    <bind keys="0,backspace,x" action="erase" keycap="0" label="erase"/>
    <bind keys="n" action="notes" label="notes"/>
    <bind keys="u" action="undo" label="undo"/>
    <bind keys="U" action="redo" label="redo"/>
    <bind keys="H" action="hint" label="hint"/>
    <bind keys="c" action="check" label="check"/>
    <bind keys="p" action="pause" label="pause"/>
    <bind keys="N" action="newgame_open" label="new"/>
    <bind keys="m" action="mouse" label="mouse"/>
  </keymap>
  <screen id="main" focus="#board">
    <col id="app">
      <row id="top">
        <text class="brand">◆ sudoku</text>
        <text class="level">{diff}</text>
        <text class="notice" if="notice">{notice}</text>
        <text class="info" if="!notice">{info}</text>
        <text class="compact">{time} · ✖{mistakes}</text>
        <text class="state" class:playing="state.playing" class:paused="state.paused" class:won="state.won">{state.label}</text>
      </row>
      <row id="stage">
        <col id="board" focusable="true">
          <!-- generated: board -->
          <row class="band">
            <box id="b0" class="box" class:cur="boxes.b0">
              <row class="line">
                <text id="c00" class="cell" class:cur="cells.c00.cur" class:peer="cells.c00.peer" class:same="cells.c00.same" class:given="cells.c00.given" class:bad="cells.c00.bad" class:wrong="cells.c00.wrong" class:note="cells.c00.note" class:done="cells.c00.done" on:click="cell">{cells.c00.t}</text>
                <text id="c01" class="cell" class:cur="cells.c01.cur" class:peer="cells.c01.peer" class:same="cells.c01.same" class:given="cells.c01.given" class:bad="cells.c01.bad" class:wrong="cells.c01.wrong" class:note="cells.c01.note" class:done="cells.c01.done" on:click="cell">{cells.c01.t}</text>
                <text id="c02" class="cell" class:cur="cells.c02.cur" class:peer="cells.c02.peer" class:same="cells.c02.same" class:given="cells.c02.given" class:bad="cells.c02.bad" class:wrong="cells.c02.wrong" class:note="cells.c02.note" class:done="cells.c02.done" on:click="cell">{cells.c02.t}</text>
              </row>
              <row class="line">
                <text id="c10" class="cell" class:cur="cells.c10.cur" class:peer="cells.c10.peer" class:same="cells.c10.same" class:given="cells.c10.given" class:bad="cells.c10.bad" class:wrong="cells.c10.wrong" class:note="cells.c10.note" class:done="cells.c10.done" on:click="cell">{cells.c10.t}</text>
                <text id="c11" class="cell" class:cur="cells.c11.cur" class:peer="cells.c11.peer" class:same="cells.c11.same" class:given="cells.c11.given" class:bad="cells.c11.bad" class:wrong="cells.c11.wrong" class:note="cells.c11.note" class:done="cells.c11.done" on:click="cell">{cells.c11.t}</text>
