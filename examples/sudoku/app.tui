                <text id="c71" class="cell" class:cur="cells.c71.cur" class:peer="cells.c71.peer" class:same="cells.c71.same" class:given="cells.c71.given" class:bad="cells.c71.bad" class:wrong="cells.c71.wrong" class:note="cells.c71.note" class:done="cells.c71.done" on:click="cell">{cells.c71.t}</text>
                <text id="c72" class="cell" class:cur="cells.c72.cur" class:peer="cells.c72.peer" class:same="cells.c72.same" class:given="cells.c72.given" class:bad="cells.c72.bad" class:wrong="cells.c72.wrong" class:note="cells.c72.note" class:done="cells.c72.done" on:click="cell">{cells.c72.t}</text>
              </row>
              <row class="line">
                <text id="c80" class="cell" class:cur="cells.c80.cur" class:peer="cells.c80.peer" class:same="cells.c80.same" class:given="cells.c80.given" class:bad="cells.c80.bad" class:wrong="cells.c80.wrong" class:note="cells.c80.note" class:done="cells.c80.done" on:click="cell">{cells.c80.t}</text>
                <text id="c81" class="cell" class:cur="cells.c81.cur" class:peer="cells.c81.peer" class:same="cells.c81.same" class:given="cells.c81.given" class:bad="cells.c81.bad" class:wrong="cells.c81.wrong" class:note="cells.c81.note" class:done="cells.c81.done" on:click="cell">{cells.c81.t}</text>
                <text id="c82" class="cell" class:cur="cells.c82.cur" class:peer="cells.c82.peer" class:same="cells.c82.same" class:given="cells.c82.given" class:bad="cells.c82.bad" class:wrong="cells.c82.wrong" class:note="cells.c82.note" class:done="cells.c82.done" on:click="cell">{cells.c82.t}</text>
              </row>
            </box>
            <box id="b7" class="box" class:cur="boxes.b7">
              <row class="line">
                <text id="c63" class="cell" class:cur="cells.c63.cur" class:peer="cells.c63.peer" class:same="cells.c63.same" class:given="cells.c63.given" class:bad="cells.c63.bad" class:wrong="cells.c63.wrong" class:note="cells.c63.note" class:done="cells.c63.done" on:click="cell">{cells.c63.t}</text>
                <text id="c64" class="cell" class:cur="cells.c64.cur" class:peer="cells.c64.peer" class:same="cells.c64.same" class:given="cells.c64.given" class:bad="cells.c64.bad" class:wrong="cells.c64.wrong" class:note="cells.c64.note" class:done="cells.c64.done" on:click="cell">{cells.c64.t}</text>
                <text id="c65" class="cell" class:cur="cells.c65.cur" class:peer="cells.c65.peer" class:same="cells.c65.same" class:given="cells.c65.given" class:bad="cells.c65.bad" class:wrong="cells.c65.wrong" class:note="cells.c65.note" class:done="cells.c65.done" on:click="cell">{cells.c65.t}</text>
              </row>
              <row class="line">
                <text id="c73" class="cell" class:cur="cells.c73.cur" class:peer="cells.c73.peer" class:same="cells.c73.same" class:given="cells.c73.given" class:bad="cells.c73.bad" class:wrong="cells.c73.wrong" class:note="cells.c73.note" class:done="cells.c73.done" on:click="cell">{cells.c73.t}</text>
                <text id="c74" class="cell" class:cur="cells.c74.cur" class:peer="cells.c74.peer" class:same="cells.c74.same" class:given="cells.c74.given" class:bad="cells.c74.bad" class:wrong="cells.c74.wrong" class:note="cells.c74.note" class:done="cells.c74.done" on:click="cell">{cells.c74.t}</text>
                <text id="c75" class="cell" class:cur="cells.c75.cur" class:peer="cells.c75.peer" class:same="cells.c75.same" class:given="cells.c75.given" class:bad="cells.c75.bad" class:wrong="cells.c75.wrong" class:note="cells.c75.note" class:done="cells.c75.done" on:click="cell">{cells.c75.t}</text>
              </row>
              <row class="line">
                <text id="c83" class="cell" class:cur="cells.c83.cur" class:peer="cells.c83.peer" class:same="cells.c83.same" class:given="cells.c83.given" class:bad="cells.c83.bad" class:wrong="cells.c83.wrong" class:note="cells.c83.note" class:done="cells.c83.done" on:click="cell">{cells.c83.t}</text>
                <text id="c84" class="cell" class:cur="cells.c84.cur" class:peer="cells.c84.peer" class:same="cells.c84.same" class:given="cells.c84.given" class:bad="cells.c84.bad" class:wrong="cells.c84.wrong" class:note="cells.c84.note" class:done="cells.c84.done" on:click="cell">{cells.c84.t}</text>
                <text id="c85" class="cell" class:cur="cells.c85.cur" class:peer="cells.c85.peer" class:same="cells.c85.same" class:given="cells.c85.given" class:bad="cells.c85.bad" class:wrong="cells.c85.wrong" class:note="cells.c85.note" class:done="cells.c85.done" on:click="cell">{cells.c85.t}</text>
              </row>
            </box>
            <box id="b8" class="box" class:cur="boxes.b8">
              <row class="line">
                <text id="c66" class="cell" class:cur="cells.c66.cur" class:peer="cells.c66.peer" class:same="cells.c66.same" class:given="cells.c66.given" class:bad="cells.c66.bad" class:wrong="cells.c66.wrong" class:note="cells.c66.note" class:done="cells.c66.done" on:click="cell">{cells.c66.t}</text>
                <text id="c67" class="cell" class:cur="cells.c67.cur" class:peer="cells.c67.peer" class:same="cells.c67.same" class:given="cells.c67.given" class:bad="cells.c67.bad" class:wrong="cells.c67.wrong" class:note="cells.c67.note" class:done="cells.c67.done" on:click="cell">{cells.c67.t}</text>
                <text id="c68" class="cell" class:cur="cells.c68.cur" class:peer="cells.c68.peer" class:same="cells.c68.same" class:given="cells.c68.given" class:bad="cells.c68.bad" class:wrong="cells.c68.wrong" class:note="cells.c68.note" class:done="cells.c68.done" on:click="cell">{cells.c68.t}</text>
              </row>
              <row class="line">
                <text id="c76" class="cell" class:cur="cells.c76.cur" class:peer="cells.c76.peer" class:same="cells.c76.same" class:given="cells.c76.given" class:bad="cells.c76.bad" class:wrong="cells.c76.wrong" class:note="cells.c76.note" class:done="cells.c76.done" on:click="cell">{cells.c76.t}</text>
                <text id="c77" class="cell" class:cur="cells.c77.cur" class:peer="cells.c77.peer" class:same="cells.c77.same" class:given="cells.c77.given" class:bad="cells.c77.bad" class:wrong="cells.c77.wrong" class:note="cells.c77.note" class:done="cells.c77.done" on:click="cell">{cells.c77.t}</text>
                <text id="c78" class="cell" class:cur="cells.c78.cur" class:peer="cells.c78.peer" class:same="cells.c78.same" class:given="cells.c78.given" class:bad="cells.c78.bad" class:wrong="cells.c78.wrong" class:note="cells.c78.note" class:done="cells.c78.done" on:click="cell">{cells.c78.t}</text>
              </row>
              <row class="line">
                <text id="c86" class="cell" class:cur="cells.c86.cur" class:peer="cells.c86.peer" class:same="cells.c86.same" class:given="cells.c86.given" class:bad="cells.c86.bad" class:wrong="cells.c86.wrong" class:note="cells.c86.note" class:done="cells.c86.done" on:click="cell">{cells.c86.t}</text>
                <text id="c87" class="cell" class:cur="cells.c87.cur" class:peer="cells.c87.peer" class:same="cells.c87.same" class:given="cells.c87.given" class:bad="cells.c87.bad" class:wrong="cells.c87.wrong" class:note="cells.c87.note" class:done="cells.c87.done" on:click="cell">{cells.c87.t}</text>
                <text id="c88" class="cell" class:cur="cells.c88.cur" class:peer="cells.c88.peer" class:same="cells.c88.same" class:given="cells.c88.given" class:bad="cells.c88.bad" class:wrong="cells.c88.wrong" class:note="cells.c88.note" class:done="cells.c88.done" on:click="cell">{cells.c88.t}</text>
              </row>
            </box>
          </row>
          <!-- end generated -->
        </col>
        <col id="side" title="{diff_label}">
          <row class="stat">
            <text class="k">time</text>
            <spacer/>
            <text class="v">{time}</text>
          </row>
          <row class="stat">
            <text class="k">mistakes</text>
            <spacer/>
            <text class="v" class:bad="mistakes">{mistakes}</text>
          </row>
          <row class="stat">
            <text class="k">hints</text>
            <spacer/>
            <text class="v">{hints}</text>
          </row>
          <row class="stat">
            <text class="k">filled</text>
            <spacer/>
            <text class="v">{filled}/81</text>
          </row>
          <row class="stat">
            <text class="k">entering</text>
            <spacer/>
            <text class="v" class:on="pencil">{mode_label}</text>
          </row>
          <rule class="sep"/>
          <row class="stat">
            <text class="k">{sel.label}</text>
            <spacer/>
            <text class="v">{sel.kind}</text>
          </row>
          <col id="mini">
            <!-- generated: mini -->
            <row class="mrow">
              <text class="m" class:on="mini.on1">{mini.n1}</text>
              <text class="m" class:on="mini.on2">{mini.n2}</text>
              <text class="m" class:on="mini.on3">{mini.n3}</text>
            </row>
            <row class="mrow">
              <text class="m" class:on="mini.on4">{mini.n4}</text>
              <text class="m" class:on="mini.on5">{mini.n5}</text>
              <text class="m" class:on="mini.on6">{mini.n6}</text>
            </row>
            <row class="mrow">
              <text class="m" class:on="mini.on7">{mini.n7}</text>
              <text class="m" class:on="mini.on8">{mini.n8}</text>
              <text class="m" class:on="mini.on9">{mini.n9}</text>
            </row>
            <!-- end generated -->
          </col>
          <rule class="sep"/>
          <!-- generated: pad -->
          <row class="padrow">
            <text id="p1" class="pad" class:done="pad.p1" on:click="put1">1</text>
            <text id="p2" class="pad" class:done="pad.p2" on:click="put2">2</text>
            <text id="p3" class="pad" class:done="pad.p3" on:click="put3">3</text>
          </row>
          <row class="padrow">
            <text id="p4" class="pad" class:done="pad.p4" on:click="put4">4</text>
            <text id="p5" class="pad" class:done="pad.p5" on:click="put5">5</text>
            <text id="p6" class="pad" class:done="pad.p6" on:click="put6">6</text>
          </row>
          <row class="padrow">
            <text id="p7" class="pad" class:done="pad.p7" on:click="put7">7</text>
            <text id="p8" class="pad" class:done="pad.p8" on:click="put8">8</text>
            <text id="p9" class="pad" class:done="pad.p9" on:click="put9">9</text>
          </row>
          <!-- end generated -->
          <row class="tools">
            <text id="t-erase" class="tool" on:click="erase">erase</text>
            <text id="t-notes" class="tool" class:on="pencil" on:click="notes">notes</text>
            <text id="t-undo" class="tool" class:off="!undo_n" on:click="undo">undo</text>
          </row>
          <row class="tools">
            <text id="t-redo" class="tool" class:off="!redo_n" on:click="redo">redo</text>
            <text id="t-hint" class="tool" on:click="hint">hint</text>
            <text id="t-check" class="tool" on:click="check">check</text>
          </row>
        </col>
      </row>
      <text id="toosmall">terminal too small: sudoku needs 40 columns by 14 rows</text>
      <text id="tiny">too small</text>
      <hints id="keys"/>
    </col>
    <modal id="help" open="help_open" title="sudoku" focus="#help-ok" on:escape="help_close">
      <row class="kv">
        <text class="kk">move</text>
        <text class="kd">arrows or hjkl</text>
      </row>
      <row class="kv">
        <text class="kk">digit</text>
        <text class="kd">1-9, or click the pad</text>
      </row>
      <row class="kv">
        <text class="kk">erase</text>
        <text class="kd">0, x, or backspace</text>
      </row>
      <row class="kv">
        <text class="kk">notes</text>
        <text class="kd">n</text>
        <text class="kk">undo</text>
        <text class="kd">u</text>
      </row>
      <row class="kv">
        <text class="kk">redo</text>
        <text class="kd">U</text>
        <text class="kk">hint</text>
        <text class="kd">H</text>
      </row>
      <row class="kv">
        <text class="kk">check</text>
        <text class="kd">c</text>
        <text class="kk">pause</text>
        <text class="kd">p</text>
      </row>
      <row class="kv">
        <text class="kk">new</text>
        <text class="kd">N</text>
        <text class="kk">mouse</text>
        <text class="kd">m</text>
      </row>
      <row class="kv">
        <text class="kk">quit</text>
        <text class="kd">q</text>
        <text class="kk">help</text>
        <text class="kd">?</text>
      </row>
      <text class="muted">A digit clears its peers' notes.</text>
      <text class="muted">A hint fills one cell and counts.</text>
      <button id="help-ok" label="close" on:click="help_close"/>
    </modal>
    <modal id="won" open="win_open" title="solved" focus="#won-new" on:escape="win_close">
      <text class="big">solved in {time}</text>
      <text>hints used {hints}  ·  mistakes {mistakes}</text>
      <text class="muted">{diff_label}</text>
      <row class="actions">
        <button id="won-new" label="new game" on:click="newgame_open"/>
        <button id="won-close" label="close" on:click="win_close"/>
      </row>
    </modal>
    <modal id="newgame" open="new_open" title="new game" focus="#nd-medium" on:escape="newgame_close">
      <text class="muted">The grade is the hardest technique a person needs.</text>
      <button id="nd-easy" label="easy" on:click="new_game"/>
      <button id="nd-medium" label="medium" on:click="new_game"/>
      <button id="nd-hard" label="hard" on:click="new_game"/>
      <button id="nd-expert" label="expert" on:click="new_game"/>
      <button id="nd-cancel" label="cancel" on:click="newgame_close"/>
    </modal>
  </screen>
</tui>
