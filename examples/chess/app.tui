              <text id="v61" class="sq dark" class:white="cells.v61.w" class:black="cells.v61.b" class:cur="cells.v61.cur" class:sel="cells.v61.sel" class:tgt="cells.v61.tgt" class:cap="cells.v61.cap" class:last="cells.v61.last" class:chk="cells.v61.chk" class:hint="cells.v61.hint" on:click="cell">{cells.v61.t}</text>
              <text id="v62" class="sq light" class:white="cells.v62.w" class:black="cells.v62.b" class:cur="cells.v62.cur" class:sel="cells.v62.sel" class:tgt="cells.v62.tgt" class:cap="cells.v62.cap" class:last="cells.v62.last" class:chk="cells.v62.chk" class:hint="cells.v62.hint" on:click="cell">{cells.v62.t}</text>
              <text id="v63" class="sq dark" class:white="cells.v63.w" class:black="cells.v63.b" class:cur="cells.v63.cur" class:sel="cells.v63.sel" class:tgt="cells.v63.tgt" class:cap="cells.v63.cap" class:last="cells.v63.last" class:chk="cells.v63.chk" class:hint="cells.v63.hint" on:click="cell">{cells.v63.t}</text>
              <text id="v64" class="sq light" class:white="cells.v64.w" class:black="cells.v64.b" class:cur="cells.v64.cur" class:sel="cells.v64.sel" class:tgt="cells.v64.tgt" class:cap="cells.v64.cap" class:last="cells.v64.last" class:chk="cells.v64.chk" class:hint="cells.v64.hint" on:click="cell">{cells.v64.t}</text>
              <text id="v65" class="sq dark" class:white="cells.v65.w" class:black="cells.v65.b" class:cur="cells.v65.cur" class:sel="cells.v65.sel" class:tgt="cells.v65.tgt" class:cap="cells.v65.cap" class:last="cells.v65.last" class:chk="cells.v65.chk" class:hint="cells.v65.hint" on:click="cell">{cells.v65.t}</text>
              <text id="v66" class="sq light" class:white="cells.v66.w" class:black="cells.v66.b" class:cur="cells.v66.cur" class:sel="cells.v66.sel" class:tgt="cells.v66.tgt" class:cap="cells.v66.cap" class:last="cells.v66.last" class:chk="cells.v66.chk" class:hint="cells.v66.hint" on:click="cell">{cells.v66.t}</text>
              <text id="v67" class="sq dark" class:white="cells.v67.w" class:black="cells.v67.b" class:cur="cells.v67.cur" class:sel="cells.v67.sel" class:tgt="cells.v67.tgt" class:cap="cells.v67.cap" class:last="cells.v67.last" class:chk="cells.v67.chk" class:hint="cells.v67.hint" on:click="cell">{cells.v67.t}</text>
            </row>
            <row class="rank">
              <text class="rl">{labels.r7}</text>
              <text id="v70" class="sq dark" class:white="cells.v70.w" class:black="cells.v70.b" class:cur="cells.v70.cur" class:sel="cells.v70.sel" class:tgt="cells.v70.tgt" class:cap="cells.v70.cap" class:last="cells.v70.last" class:chk="cells.v70.chk" class:hint="cells.v70.hint" on:click="cell">{cells.v70.t}</text>
              <text id="v71" class="sq light" class:white="cells.v71.w" class:black="cells.v71.b" class:cur="cells.v71.cur" class:sel="cells.v71.sel" class:tgt="cells.v71.tgt" class:cap="cells.v71.cap" class:last="cells.v71.last" class:chk="cells.v71.chk" class:hint="cells.v71.hint" on:click="cell">{cells.v71.t}</text>
              <text id="v72" class="sq dark" class:white="cells.v72.w" class:black="cells.v72.b" class:cur="cells.v72.cur" class:sel="cells.v72.sel" class:tgt="cells.v72.tgt" class:cap="cells.v72.cap" class:last="cells.v72.last" class:chk="cells.v72.chk" class:hint="cells.v72.hint" on:click="cell">{cells.v72.t}</text>
              <text id="v73" class="sq light" class:white="cells.v73.w" class:black="cells.v73.b" class:cur="cells.v73.cur" class:sel="cells.v73.sel" class:tgt="cells.v73.tgt" class:cap="cells.v73.cap" class:last="cells.v73.last" class:chk="cells.v73.chk" class:hint="cells.v73.hint" on:click="cell">{cells.v73.t}</text>
              <text id="v74" class="sq dark" class:white="cells.v74.w" class:black="cells.v74.b" class:cur="cells.v74.cur" class:sel="cells.v74.sel" class:tgt="cells.v74.tgt" class:cap="cells.v74.cap" class:last="cells.v74.last" class:chk="cells.v74.chk" class:hint="cells.v74.hint" on:click="cell">{cells.v74.t}</text>
              <text id="v75" class="sq light" class:white="cells.v75.w" class:black="cells.v75.b" class:cur="cells.v75.cur" class:sel="cells.v75.sel" class:tgt="cells.v75.tgt" class:cap="cells.v75.cap" class:last="cells.v75.last" class:chk="cells.v75.chk" class:hint="cells.v75.hint" on:click="cell">{cells.v75.t}</text>
              <text id="v76" class="sq dark" class:white="cells.v76.w" class:black="cells.v76.b" class:cur="cells.v76.cur" class:sel="cells.v76.sel" class:tgt="cells.v76.tgt" class:cap="cells.v76.cap" class:last="cells.v76.last" class:chk="cells.v76.chk" class:hint="cells.v76.hint" on:click="cell">{cells.v76.t}</text>
              <text id="v77" class="sq light" class:white="cells.v77.w" class:black="cells.v77.b" class:cur="cells.v77.cur" class:sel="cells.v77.sel" class:tgt="cells.v77.tgt" class:cap="cells.v77.cap" class:last="cells.v77.last" class:chk="cells.v77.chk" class:hint="cells.v77.hint" on:click="cell">{cells.v77.t}</text>
            </row>
          </col>
          <row id="files">
            <text class="rl"/>
            <text class="fl">{labels.f0}</text>
            <text class="fl">{labels.f1}</text>
            <text class="fl">{labels.f2}</text>
            <text class="fl">{labels.f3}</text>
            <text class="fl">{labels.f4}</text>
            <text class="fl">{labels.f5}</text>
            <text class="fl">{labels.f6}</text>
            <text class="fl">{labels.f7}</text>
          </row>
          <!-- board:end -->
        </col>
        <col id="side">
          <col id="p-top" class="player" class:turn="top.turn">
            <row class="pl">
              <text class="mark">{top.mark}</text>
              <text class="glyph" class:white="top.white" class:black="top.black">{top.glyph}</text>
              <text class="name">{top.name}</text>
              <spacer/>
              <text class="clk" class:low="top.low" class:run="top.run">{top.clock}</text>
            </row>
            <row class="takenrow">
              <text class="taken" class:white="top.capwhite" class:black="top.capblack">{top.cap}</text>
              <text class="lead">{top.lead}</text>
            </row>
          </col>
          <list id="moves" each="mrows as r" key="r.n" bind="mcur" focusable="false" title="moves">
            <item>
              <row class="mv">
                <text class="mn">{r.n}.</text>
                <text class="mw" class:now="r.cw">{r.w}</text>
                <text class="mb" class:now="r.cb">{r.b}</text>
              </row>
            </item>
          </list>
          <col id="p-bot" class="player" class:turn="bot.turn">
            <row class="pl">
              <text class="mark">{bot.mark}</text>
              <text class="glyph" class:white="bot.white" class:black="bot.black">{bot.glyph}</text>
              <text class="name">{bot.name}</text>
              <spacer/>
              <text class="clk" class:low="bot.low" class:run="bot.run">{bot.clock}</text>
            </row>
            <row class="takenrow">
              <text class="taken" class:white="bot.capwhite" class:black="bot.capblack">{bot.cap}</text>
              <text class="lead">{bot.lead}</text>
            </row>
          </col>
          <col id="status" class:over="status.over" class:check="status.check" class:review="status.review">
            <text class="st">{status.text}</text>
            <text class="sub">{status.sub}</text>
          </col>
          <row id="evalrow">
            <text class="muted">eval</text>
            <progress id="evalbar" bind="evalbar.pct"/>
            <text class="evl">{evalbar.label}</text>
          </row>
          <col id="engine" title="engine">
            <text class="eng">{engine_view.line}</text>
            <text class="pv">{engine_view.pv}</text>
          </col>
        </col>
      </row>
      <row id="cmdbar">
        <text class="prompt">:</text>
        <input id="cmd" bind="cmd" placeholder="type a move: Nf3  exd5  O-O  e2e4" on:submit="cmd_submit"/>
      </row>
      <hints id="keys"/>
    </col>
    <modal id="help" open="help_open" title="chess keys" on:escape="help_close" focus="#help-ok">
      <scroll id="help-scroll" axis="y" focusable="true">
        <text class="muted">Click a piece, then a square. Or press : and type a move: Nf3, exd5, O-O, e8=Q, e2e4.</text>
        <text class="muted">Arrows (and h j k l) move the cursor; enter or space selects, and moves.</text>
        <text class="muted">u undoes (your move and the reply), U redoes, f flips the board, n starts a new game.</text>
        <text class="muted">H shows the best move, d claims a draw (fifty moves, threefold), r resigns.</text>
        <text class="muted">v reviews the game: the arrows, home, and end step through it, and enter plays on from there.</text>
        <text class="muted">p exports the PGN, m turns the mouse off for text selection, L switches letters.</text>
        <text class="muted">tab moves between the board and the move box, esc leaves the box or a dialog, q quits.</text>
      </scroll>
      <button id="help-ok" label="close" on:click="help_close"/>
    </modal>
    <modal id="newgame" open="new_open" title="new game" on:escape="ng_cancel" focus="#ng-start">
      <row id="ng-mode" class="opt" focusable="true" on:click="ng_mode">
        <text class="k">m</text>
        <text class="lbl">mode</text>
        <text class="v">{ng_view.mode}</text>
      </row>
      <row id="ng-side" class="opt" if="ng_view.hvc" focusable="true" on:click="ng_side">
        <text class="k">s</text>
        <text class="lbl">you play</text>
        <text class="v">{ng_view.side}</text>
      </row>
      <row id="ng-level" class="opt" if="ng_view.engine" focusable="true" on:click="ng_level">
        <text class="k">l</text>
        <text class="lbl">level</text>
        <text class="v">{ng_view.level}</text>
      </row>
      <row id="ng-clock" class="opt" focusable="true" on:click="ng_clock">
        <text class="k">c</text>
        <text class="lbl">clock</text>
        <text class="v">{ng_view.clock}</text>
      </row>
      <row class="actions">
        <button id="ng-start" label="start" on:click="ng_start"/>
        <button id="ng-cancel" label="cancel" on:click="ng_cancel"/>
      </row>
    </modal>
    <modal id="resign" open="resign_open" title="resign?" on:escape="resign_no" focus="#resign-no">
      <text class="muted">Resign this game?</text>
      <row class="actions">
        <button id="resign-yes" label="resign" on:click="resign_yes"/>
        <button id="resign-no" label="keep playing" on:click="resign_no"/>
      </row>
    </modal>
    <modal id="promo" open="promo_open" title="promote to" on:escape="promo_cancel" focus="#promo-q">
      <row class="actions">
        <button id="promo-q" label="queen" on:click="promo_q"/>
        <button id="promo-r" label="rook" on:click="promo_r"/>
      </row>
      <row class="actions">
        <button id="promo-b" label="bishop" on:click="promo_b"/>
        <button id="promo-n" label="knight" on:click="promo_n"/>
      </row>
    </modal>
    <modal id="pgn" open="pgn_open" title="pgn" on:escape="pgn_close" focus="#pgn-ok">
      <scroll id="pgn-scroll" axis="y" focusable="true">
        <text>{pgn_text}</text>
      </scroll>
      <button id="pgn-ok" label="close" on:click="pgn_close"/>
    </modal>
  </screen>
</tui>
