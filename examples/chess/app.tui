<tui version="3" theme="auto" mouse="mouse">
  <style src="theme.tcss"/>
  <keymap when="#board">
    <bind keys="?" action="help_open" label="help"/>
    <bind keys="q" action="quit" label="quit"/>
    <bind keys="ctrl+c" action="quit" when=""/>
    <bind keys="up,k" action="up" keycap="↑↓←→" label="move"/>
    <bind keys="down,j" action="down"/>
    <bind keys="left,h" action="left"/>
    <bind keys="right,l" action="right"/>
    <bind keys="home" action="first"/>
    <bind keys="end" action="last"/>
    <bind keys="enter,space" action="select" keycap="enter" label="select"/>
    <bind keys=":,/" action="focus" to="#cmd" keycap=":" label="type"/>
    <bind keys="u" action="undo" label="undo"/>
    <bind keys="U" action="redo" label="redo"/>
    <bind keys="n" action="new_open" label="new"/>
    <bind keys="f" action="flip" label="flip"/>
    <bind keys="H" action="hint" label="hint"/>
    <bind keys="r" action="resign_open" label="resign"/>
    <bind keys="d" action="claim" label="draw"/>
    <bind keys="v" action="review" label="review"/>
    <bind keys="p" action="pgn" label="pgn"/>
    <bind keys="m" action="toggle_mouse" label="mouse"/>
    <bind keys="L" action="toggle_letters" label="letters"/>
  </keymap>
  <keymap when="#cmd">
    <bind keys="esc" action="cmd_cancel" label="leave"/>
  </keymap>
  <keymap when="#help">
    <bind keys="?,q,enter" action="help_close" label="close"/>
  </keymap>
  <keymap when="#newgame">
    <bind keys="m" action="ng_mode" label="mode"/>
    <bind keys="s" action="ng_side" label="side"/>
    <bind keys="l" action="ng_level" label="level"/>
    <bind keys="c" action="ng_clock" label="clock"/>
  </keymap>
  <keymap when="#resign">
    <bind keys="y" action="resign_yes" label="resign"/>
    <bind keys="n" action="resign_no" label="keep playing"/>
  </keymap>
  <keymap when="#promo">
    <bind keys="q" action="promo_q" label="queen"/>
    <bind keys="r" action="promo_r" label="rook"/>
    <bind keys="b" action="promo_b" label="bishop"/>
    <bind keys="n" action="promo_n" label="knight"/>
  </keymap>
  <keymap when="#pgn">
    <bind keys="q,p,enter" action="pgn_close" label="close"/>
  </keymap>
  <screen id="main" focus="#board">
    <col id="app">
      <row id="top">
        <text class="brand">◆ chess</text>
        <text class="mode" if="!notice">{mode_label}</text>
        <text class="notice" if="notice">{notice}</text>
        <spacer id="topgap"/>
        <text class="compact" class:over="status.over" class:check="status.check" if="!notice">{status.text}</text>
        <text class="think" if="thinking">{think_label}</text>
        <text class="cclk" if="clocks_line">{clocks_line}</text>
      </row>
      <row id="stage">
        <col id="boardbox">
          <!-- board:begin -->
          <col id="board" focusable="true">
            <row class="rank">
              <text class="rl">{labels.r0}</text>
              <text id="v00" class="sq light" class:white="cells.v00.w" class:black="cells.v00.b" class:cur="cells.v00.cur" class:sel="cells.v00.sel" class:tgt="cells.v00.tgt" class:cap="cells.v00.cap" class:last="cells.v00.last" class:chk="cells.v00.chk" class:hint="cells.v00.hint" on:click="cell">{cells.v00.t}</text>
              <text id="v01" class="sq dark" class:white="cells.v01.w" class:black="cells.v01.b" class:cur="cells.v01.cur" class:sel="cells.v01.sel" class:tgt="cells.v01.tgt" class:cap="cells.v01.cap" class:last="cells.v01.last" class:chk="cells.v01.chk" class:hint="cells.v01.hint" on:click="cell">{cells.v01.t}</text>
              <text id="v02" class="sq light" class:white="cells.v02.w" class:black="cells.v02.b" class:cur="cells.v02.cur" class:sel="cells.v02.sel" class:tgt="cells.v02.tgt" class:cap="cells.v02.cap" class:last="cells.v02.last" class:chk="cells.v02.chk" class:hint="cells.v02.hint" on:click="cell">{cells.v02.t}</text>
