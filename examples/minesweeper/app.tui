<tui version="3" theme="auto" mouse="settings.mouse">
  <style src="theme.tcss"/>
  <style src="sizes.tcss"/>
  <keymap>
    <bind keys="?" action="help_toggle" label="help"/>
    <bind keys="q,ctrl+c" action="quit" keycap="q" label="quit"/>
  </keymap>
  <keymap when="#board">
    <bind keys="up,k" action="cur_up" keycap="↑↓←→" label="move"/>
    <bind keys="down,j" action="cur_down"/>
    <bind keys="left,h" action="cur_left"/>
    <bind keys="right,l" action="cur_right"/>
    <bind keys="enter,space" action="reveal" keycap="enter" label="reveal"/>
    <bind keys="f" action="flag_mode" label="flag mode"/>
    <bind keys="g" action="flag" label="flag"/>
    <bind keys="n" action="new" label="new"/>
    <bind keys="1" action="level_beginner" keycap="1-3" label="level"/>
    <bind keys="2" action="level_intermediate"/>
    <bind keys="3" action="level_expert"/>
    <bind keys="p" action="pause" label="pause"/>
    <bind keys="m" action="toggle_mouse" label="mouse"/>
  </keymap>
  <keymap when="#help">
    <bind keys="enter" action="help_close"/>
  </keymap>
  <screen id="main" focus="#board">
    <col id="app" class:nc36="fit.nc36" class:nc38="fit.nc38" class:nc40="fit.nc40" class:nc42="fit.nc42" class:nc44="fit.nc44" class:nc46="fit.nc46" class:nc48="fit.nc48" class:nc50="fit.nc50" class:nc52="fit.nc52" class:nc54="fit.nc54" class:nc56="fit.nc56" class:nc58="fit.nc58" class:nc60="fit.nc60" class:nc62="fit.nc62" class:nh13="fit.nh13" class:nh14="fit.nh14" class:nh15="fit.nh15" class:nh16="fit.nh16" class:nh17="fit.nh17" class:nh18="fit.nh18" class:nh19="fit.nh19" class:nh20="fit.nh20">
      <row id="top">
        <text class="brand">◆ minesweeper</text>
        <text class="level" if="!notice">{level_label}</text>
        <text class="notice" if="notice">{notice}</text>
        <spacer/>
        <row id="compact">
          <text class="face" class:lost="is.lost" class:won="is.won">{face}</text>
          <text class="state" class:lost="is.lost" class:won="is.won" class:paused="is.paused">{state_label}</text>
          <text class="k">mines</text>
          <text class="v">{mines_label}</text>
          <text class="v">{time_label}</text>
          <text class="k best">best</text>
          <text class="v best">{best_now}</text>
          <text class="flagmode" if="flag_mode">flag</text>
        </row>
      </row>
      <row id="stage">
        <col id="board" class:paused="is.paused" class:lost="is.lost" class:won="is.won" focusable="true">
          <!-- generated: the board, from gen_test.go (UPDATE_TUI=1 go test ./examples/minesweeper -run TestGenerated) -->
          <row id="r00" class="mrow" if="rows.r00">
            <text id="c0000" class="cell" class:hid="b.c0000.hid" class:n1="b.c0000.n1" class:n2="b.c0000.n2" class:n3="b.c0000.n3" class:n4="b.c0000.n4" class:n5="b.c0000.n5" class:n6="b.c0000.n6" class:n7="b.c0000.n7" class:n8="b.c0000.n8" class:flag="b.c0000.flag" class:q="b.c0000.q" class:mine="b.c0000.mine" class:boom="b.c0000.boom" class:wrong="b.c0000.wrong" class:cur="b.c0000.cur" on:click="cell" if="b.c0000.on">{b.c0000.t}</text>
            <text id="c0001" class="cell alt" class:hid="b.c0001.hid" class:n1="b.c0001.n1" class:n2="b.c0001.n2" class:n3="b.c0001.n3" class:n4="b.c0001.n4" class:n5="b.c0001.n5" class:n6="b.c0001.n6" class:n7="b.c0001.n7" class:n8="b.c0001.n8" class:flag="b.c0001.flag" class:q="b.c0001.q" class:mine="b.c0001.mine" class:boom="b.c0001.boom" class:wrong="b.c0001.wrong" class:cur="b.c0001.cur" on:click="cell" if="b.c0001.on">{b.c0001.t}</text>
            <text id="c0002" class="cell" class:hid="b.c0002.hid" class:n1="b.c0002.n1" class:n2="b.c0002.n2" class:n3="b.c0002.n3" class:n4="b.c0002.n4" class:n5="b.c0002.n5" class:n6="b.c0002.n6" class:n7="b.c0002.n7" class:n8="b.c0002.n8" class:flag="b.c0002.flag" class:q="b.c0002.q" class:mine="b.c0002.mine" class:boom="b.c0002.boom" class:wrong="b.c0002.wrong" class:cur="b.c0002.cur" on:click="cell" if="b.c0002.on">{b.c0002.t}</text>
