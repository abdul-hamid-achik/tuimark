          </row>
          <!-- end generated -->
        </col>
        <col id="side" title="minesweeper">
          <row class="stat">
            <text class="face" class:lost="is.lost" class:won="is.won">{face}</text>
            <text class="state" class:lost="is.lost" class:won="is.won" class:paused="is.paused">{state_label}</text>
          </row>
          <row class="stat">
            <text class="k">mines left</text>
            <spacer/>
            <text class="v">{mines_label}</text>
          </row>
          <row class="stat">
            <text class="k">time</text>
            <spacer/>
            <text class="v">{time_label}</text>
          </row>
          <row class="stat">
            <text class="k">a click</text>
            <spacer/>
            <text class="v" class:flagmode="flag_mode">{mode_label}</text>
          </row>
          <rule class="sep"/>
          <text class="k">best times</text>
          <row class="stat" class:here="lvl.beginner">
            <text class="k">beginner</text>
            <spacer/>
            <text class="v">{best_label.beginner}</text>
          </row>
          <row class="stat" class:here="lvl.intermediate">
            <text class="k">intermediate</text>
            <spacer/>
            <text class="v">{best_label.intermediate}</text>
          </row>
          <row class="stat" class:here="lvl.expert">
            <text class="k">expert</text>
            <spacer/>
            <text class="v">{best_label.expert}</text>
          </row>
        </col>
      </row>
      <text id="toosmall">{need_label}</text>
      <hints id="keys"/>
    </col>
    <modal id="help" open="help_open" title="minesweeper" focus="#help-body" on:escape="help_close">
      <scroll id="help-body" focusable="true">
        <row class="kv">
          <text class="hk">click</text>
          <text class="hd">reveal; on a number, chord</text>
        </row>
        <row class="kv">
          <text class="hk">enter space</text>
          <text class="hd">the same at the cursor</text>
        </row>
        <row class="kv">
          <text class="hk">arrows hjkl</text>
          <text class="hd">move the cursor</text>
        </row>
        <row class="kv">
          <text class="hk">f</text>
          <text class="hd">flag mode: a click flags</text>
        </row>
        <row class="kv">
          <text class="hk">g</text>
          <text class="hd">flag, ? or clear the cursor cell</text>
        </row>
        <row class="kv">
          <text class="hk">n</text>
          <text class="hd">new game, same level</text>
        </row>
        <row class="kv">
          <text class="hk">1 2 3</text>
          <text class="hd">beginner, intermediate, expert</text>
        </row>
        <row class="kv">
          <text class="hk">p</text>
          <text class="hd">pause: hides the board</text>
        </row>
        <row class="kv">
          <text class="hk">m</text>
          <text class="hd">mouse on or off</text>
        </row>
        <row class="kv">
          <text class="hk">? esc enter</text>
          <text class="hd">open or close this help</text>
        </row>
        <row class="kv">
          <text class="hk">q ctrl+c</text>
          <text class="hd">quit</text>
        </row>
        <text class="muted">The first reveal is never a mine.</text>
        <text class="muted">Chord: an open number with all its flags set opens the cells around it.</text>
      </scroll>
      <button id="help-ok" label="close" on:click="help_close"/>
    </modal>
  </screen>
</tui>
