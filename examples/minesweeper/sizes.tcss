/* Written by gen_test.go (UPDATE_TUI=1 go test ./examples/minesweeper -run TestGenerated); do not edit by hand.
   #app carries ncN for the columns the current board needs (the board in its frame, at least 36) and nhN for the rows (the board, the status line, the key hints). */

/* 36 columns: the side panel (30 columns more) fits from 66. Below that the counters move into the status line, which drops the brand and, up to 75 columns, the level label. */
@media (max-cols: 65) {
  #app.nc36 > #stage > #side { display: none; }
  #app.nc36 > #top > #compact { display: flex; }
  #app.nc36 > #top > .brand { display: none; }
}
@media (max-cols: 65) {
  #app.nc36 > #top > .level { display: none; }
}
@media (max-cols: 35) {
  #app.nc36 > #stage { display: none; }
  #app.nc36 > #toosmall { display: flex; }
}
@media (max-cols: 35) {
  #app.nc36 > #top > #compact { display: none; }
}

