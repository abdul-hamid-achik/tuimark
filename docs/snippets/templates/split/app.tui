<tui>
  <include src="parts/forms.tui"/>
  <screen id="main" focus="#billing__street__input">
    <col gap="1" pad="1">
      <use id="billing" template="address" with="order.billing as a"/>
      <use id="shipping" template="address" with="order.shipping as a" if="order.ship_elsewhere"/>
    </col>
  </screen>
</tui>
