# Build output
/bin/
*.exe
*.test
*.out

# glyphrun run artifacts (per-run logs, screens, replays); snapshots are
# fixtures and stay tracked.
/.glyphrun/runs/

# Go
/vendor/

# GoReleaser output (goreleaser release --snapshot / build)
/dist/

# Docs site (VitePress under docs/, deployed by Vercel)
node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
.vercel

# VS Code extension (editors/vscode): build output and packages
/editors/vscode/out/
*.vsix

# Editor/OS cruft
.DS_Store
*.swp

# agent demo workspaces recreated by specs (bin/agent --demo-workspace)
/.glyphrun/ws/

# Claude Code local state (scheduler lock, per-machine settings)
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
.env*
/.claude/worktrees/

# A built example binary (go build in its directory) is never committed.
/examples/pomodoro/pomodoro
