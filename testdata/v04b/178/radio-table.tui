<tui>
  <keymap>
    <bind keys="x" action="check-none" when="#size:focus"/>
    <bind keys="a" action="check-all"/>
    <bind keys="a" action="all_fallback"/>
  </keymap>
  <screen id="main" focus="#size">
    <table id="size" each="sizes as it" key="it.id" checked="size" single="true" mark="●" on:change="size_changed">
      <column>{it.label}</column>
    </table>
  </screen>
</tui>
