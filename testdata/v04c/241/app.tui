<tui>
  <template id="frame">
    <slot/>
  </template>
  <template id="panel">
    <box class="panel" border="single">
      <slot/>
    </box>
  </template>
  <template id="outer">
    <use template="frame" class="inner">
      <text class="mine">o</text>
    </use>
  </template>
  <screen id="main">
    <use template="frame" class="wrap">
      <text class="f">a</text>
    </use>
    <use template="outer" class="top"/>
    <use template="panel" class="p"/>
    <use template="panel" if="show">
      <text>hidden</text>
    </use>
  </screen>
</tui>
