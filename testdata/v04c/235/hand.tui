<tui>
  <screen id="main" focus="#logs-view">
    <tabs id="nav">
      <tab id="detail" label="2 detail" short="2 det" focus="#logs-view">
        <col id="detail__page" width="1fr" height="1fr">
          <row id="detail__top" width="1fr" height="auto" gap="1">
            <box class="k-card" title="{detail.name}">
              <row class="k-card-row">
                <text class="k-card-muted" width="8">status</text>
                <text class="k-badge" class:ok="detail.ok" class:warn="detail.warn" class:danger="detail.bad">{detail.state}</text>
                <text class="k-card-muted">up {detail.up}</text>
              </row>
              <row class="k-card-row">
                <text class="k-card-muted" width="8">image</text>
                <text class="k-card-text" width="1fr">{detail.image}</text>
              </row>
              <row class="k-card-row">
                <text class="k-card-muted" width="8">id</text>
                <text class="k-card-text" width="1fr">{detail.id}</text>
              </row>
              <row class="k-card-row">
                <text class="k-card-muted" width="8">network</text>
                <text class="k-card-text" width="1fr">{detail.network}</text>
              </row>
              <row class="k-card-row">
                <text class="k-card-muted" width="8">restart</text>
                <text class="k-card-text" width="1fr">{detail.restart}</text>
              </row>
              <row class="k-card-row">
                <text class="k-card-muted" width="8">created</text>
                <text class="k-card-text" width="1fr">{detail.created}</text>
              </row>
            </box>
            <col id="detail__stats" width="1fr" height="auto">
              <box class="k-stat" title="CPU">
                <text class="k-stat-value">{detail.cpu_txt}</text>
                <row class="k-stat-row">
                  <text class="k-stat-delta">{detail.cpu_avg}</text>
                  <sparkline class="k-stat-spark" bind="detail.cpu_hist" min="0"/>
                </row>
              </box>
              <box class="k-stat" title="Memory">
                <text class="k-stat-value">{detail.mem_txt}</text>
                <row class="k-stat-row">
                  <text class="k-stat-delta">{detail.mem_avg}</text>
                  <sparkline class="k-stat-spark" bind="detail.mem_hist" min="0" max="100"/>
                </row>
              </box>
            </col>
          </row>
          <tabs id="dtabs" class="k-tabs" bind="detail_tab" mark="▸" focusable="true">
            <tab id="logs" label="logs ({detail.nlogs})" short="logs" focus="#logs-view">
              <scroll id="logs-view" class="k-log" stick="bottom" focusable="true" title="{detail.name} · log">
                <col class="k-log-lines" each="detail.logs as l" key="l.n">
                  <text class="k-log-line" class:muted="l.debug" class:info="l.info" class:warn="l.warn" class:danger="l.err">{l.text}</text>
                </col>
              </scroll>
            </tab>
            <tab id="env" label="env ({detail.nenv})" short="env">
              <table id="envt" class="k-table" each="detail.env as e" key="e.k" title="Environment" placeholder="no environment variables">
                <column id="envt__k" class="k-table-muted" title="VARIABLE" width="40%">{e.k}</column>
                <column id="envt__v" title="VALUE" width="1fr">{e.v}</column>
              </table>
            </tab>
            <tab id="ports" label="ports ({detail.nports})" short="ports">
              <table id="portt" class="k-table" each="detail.port_rows as p" key="p.key" title="Published ports" placeholder="no published ports">
                <column id="portt__host" class="k-num" title="HOST" width="6">{p.host}</column>
                <column id="portt__cont" class="k-num" title="CONTAINER" width="9">{p.cont}</column>
                <column id="portt__proto" class="k-table-muted" title="PROTO" width="6">{p.proto}</column>
                <column id="portt__addr" title="BIND" width="1fr" priority="1">{p.addr}</column>
              </table>
            </tab>
          </tabs>
        </col>
      </tab>
    </tabs>
  </screen>
</tui>
