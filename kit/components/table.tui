<tui version="3" theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <keymap when="#svc">
    <bind keys="j" action="move-next"/>
    <bind keys="k" action="move-prev"/>
    <bind keys="enter" action="svc_open" label="open"/>
  </keymap>
  <screen id="demo" focus="#svc">
    <col width="1fr" height="1fr" gap="0">
      <!-- COPY: a data table is a `table` with class `dtable`. The header
           is the `column` titles (bold, muted). Give a `column` the class
           `num` for numbers: the header and every cell of it align to the
           right. Columns with `priority` hide, lowest first, when the
           table is too narrow, so give the least important column the
           smallest number, and give the `1fr` column a
           `min-width` (the class `cell-name`) so columns hide before it is
           squeezed. `bind` receives the cursor row's key;
           `on:select` fires as the cursor moves. The selected row is drawn
           with `$selected` (a stronger color while the table has focus). -->
      <table id="svc" class="dtable" each="services as s" key="s.id" bind="cur" title="Services · {count}" placeholder="no services" on:select="svc_select">
        <column id="c-name" class="cell-name" title="SERVICE" width="1fr">{s.name}</column>
        <column id="c-state" title="STATE" width="9" class:cell-success="s.ok" class:cell-danger="!s.ok">{s.state}</column>
        <column id="c-region" class="cell-muted" title="REGION" width="10" priority="1">{s.region}</column>
        <column id="c-rps" class="num" title="REQ/S" width="8" priority="2">{s.rps}</column>
        <column id="c-p95" class="num" title="P95 MS" width="8" priority="3">{s.p95}</column>
      </table>
      <hints class="hintbar"/>
    </col>
  </screen>
</tui>
