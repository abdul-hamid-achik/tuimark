<tui version="3" theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <keymap>
    <bind keys="ctrl+k" action="palette_open" keycap="^K" label="commands"/>
  </keymap>
  <!-- COPY: while the palette is open, up / down (and ctrl+n / ctrl+p) move
       the cursor of the list although focus stays in the input: the input
       does not consume them, so they reach the keymap, and the built-ins
       act on the list named by `to`. Enter is the input's `on:submit`. -->
  <keymap when="#palette">
    <bind keys="down,ctrl+n" action="move-next" to="#palette-list"/>
    <bind keys="up,ctrl+p" action="move-prev" to="#palette-list"/>
  </keymap>
  <screen id="demo">
    <col width="1fr" height="1fr" gap="1" pad="1">
      <text class="title">command palette</text>
      <text class="muted">ctrl+k opens it; type, up / down, enter, esc.</text>
      <text class="muted">last command: {palette.last}</text>
      <hints class="hintbar"/>
    </col>
    <!-- COPY: a modal with class `palette`: an input bound to the query, and
         a list over the filtered commands. The filtering is the HOST's job
         (no expressions in the markup): keep `found` with a Derive over
         `palette.query` and `palette.commands`, so the list always reads the
         result. The list `bind` is the cursor row's id. -->
    <modal id="palette" class="palette" open="palette.open" title="Command palette" focus="#palette-input" on:escape="palette_close">
      <input id="palette-input" class="palette-input" bind="palette.query" placeholder="type a command…" on:submit="palette_run"/>
      <text class="empty-text" if="!found.any">No command matches “{palette.query}”.</text>
      <list id="palette-list" class="palette-list" each="found.items as r" key="r.id" bind="palette.cur" focusable="false">
        <item>
          <row class="palette-row">
            <text class="palette-label">{r.label}</text>
            <text class="palette-hint">{r.hint}</text>
          </row>
        </item>
      </list>
    </modal>
  </screen>
</tui>
