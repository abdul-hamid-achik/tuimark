<tui version="3" theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <keymap when="#confirm">
    <bind keys="y" action="confirm_accept" label="confirm"/>
    <bind keys="n" action="confirm_cancel" label="cancel"/>
  </keymap>
  <screen id="demo" focus="#ask">
    <col width="1fr" height="1fr" gap="1" pad="1">
      <text class="title">confirm dialog</text>
      <row width="1fr" height="1" gap="2">
        <button id="ask" class="btn danger" label="Delete project" on:click="confirm_open"/>
      </row>
      <text class="muted">result: {confirm.result}</text>
    </col>
    <!-- COPY: a confirm dialog is a `modal` with class `dialog` (add `danger`
         for a destructive one), the message, and an action row of
         `dialog-actions` (height 1). The modal must be the LAST child of the
         screen (L004). `open` is a path the host flips; `focus` puts the
         cursor on the SAFE button, so a stray enter cancels. `on:escape`
         cancels. y / n work too (the keymap above). Keep the button labels
         short: the action row must fit a 40-column terminal. -->
    <modal id="confirm" class="dialog danger" open="confirm.open" title="{confirm.title}" focus="#confirm-no" on:escape="confirm_cancel">
      <text class="dialog-text">{confirm.message}</text>
      <row class="dialog-actions">
        <spacer/>
        <button id="confirm-no" class="btn secondary" label="Cancel" on:click="confirm_cancel"/>
        <button id="confirm-yes" class="btn danger" label="Delete" on:click="confirm_accept"/>
      </row>
    </modal>
  </screen>
</tui>
