<!-- k-block · Contract: props style; with="PATH as blk" over an element of an array of {id, runs, code, head, quote, item, rule}: runs is an array of strings or {text, class} (the classes k-strong, k-em and k-code style a run), the five flags are optional booleans (false when missing) · Actions: none · Keys: none · Requires: k-strong, k-em, k-code -->
<tui theme="auto">
  <include src="../kit.tui"/>
  <screen id="demo">
    <scroll width="1fr" height="1fr" pad="1">
      <!-- USE: one k-block per element of an array of {id, runs, …}. The
           block is a paragraph of runs; a flag turns it into a heading
           (head), a quoted paragraph (quote), a list item (item), a code
           block that keeps its line breaks and spaces (code, wrap:
           pre-wrap), or a horizontal rule (rule, no text). The schema is a
           pattern, not the language: markdownToBlocks in examples/host-ts
           makes it from markdown. The same use shows a transcript, and a
           host commits one block at a time into the scrollback with
           Commit (see the inline guide). Flags are read through the alias,
           so a block that omits one reads it as false with no diagnostic. -->
      <col each="blocks as b" key="b.id" height="auto">
        <use template="k-block" with="b as blk"/>
      </col>
    </scroll>
  </screen>
</tui>
