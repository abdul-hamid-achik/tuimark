<!-- k-alert · Contract: with="PATH as a" reads a.title, a.text, and a.icon when there is one · Actions: none · Keys: none · Requires: k-title -->
<tui theme="auto">
  <include src="../kit.tui"/>
  <screen id="demo">
    <col width="1fr" height="1fr" gap="0" pad="1">
      <text class="k-title">alert / callout</text>
      <!-- USE: one <use> of the k-alert template per alert, with its
           variant as the use's class (info, ok, warn, danger) and its data
           through `with`. The title is the box title; the text wraps; the
           variant colors the frame and the icon. -->
      <use template="k-alert" class="info" with="alerts.info as a"/>
      <use template="k-alert" class="ok" with="alerts.ok as a"/>
      <use template="k-alert" class="warn" with="alerts.warn as a"/>
      <use template="k-alert" class="danger" with="alerts.danger as a"/>
    </col>
  </screen>
</tui>
