<!-- k-alert · Contract: reads alert.message · Actions: none · Keys: none · Requires: k-title -->
<tui theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <screen id="demo">
    <col width="1fr" height="1fr" gap="0" pad="1">
      <text class="k-title">alert / callout</text>
      <!-- COPY: an alert is a `box` with class `k-alert` plus a modifier
           (info, ok, warn, danger). The title is the box title; the body
           wraps. `k-alert-icon` takes the same modifier so it matches. -->
      <box class="k-alert info" title="Heads up">
        <row class="k-alert-row">
          <text class="k-alert-icon info">i</text>
          <text class="k-alert-text">Deploys are paused until 09:00 UTC.</text>
        </row>
      </box>
      <box class="k-alert ok" title="Saved">
        <row class="k-alert-row">
          <text class="k-alert-icon ok">✓</text>
          <text class="k-alert-text">Your changes are live in every region.</text>
        </row>
      </box>
      <box class="k-alert warn" title="Quota">
        <row class="k-alert-row">
          <text class="k-alert-icon warn">!</text>
          <text class="k-alert-text">You have used 92% of this month's build minutes.</text>
        </row>
      </box>
      <box class="k-alert danger" title="Build failed">
        <row class="k-alert-row">
          <text class="k-alert-icon danger">✗</text>
          <text class="k-alert-text">{alert.message}</text>
        </row>
      </box>
    </col>
  </screen>
</tui>
