<!-- k-meter · Contract: reads meters.upload.{label, text, pct}, meters.disk.{text, pct, warn, crit}, meters.tests.{text, pct} (pct is 0 to 100) · Actions: none · Keys: none · Requires: k-title -->
<tui theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <screen id="demo">
    <col width="1fr" height="1fr" gap="1" pad="1">
      <text class="k-title">labeled progress</text>
      <!-- COPY: a meter is a `col` with class `k-meter`: a head row (label
           on the left, the value text on the right) over a `progress` with
           class `k-meter-bar`. `bind` is a number from 0 to 100. Add a
           status color to the bar with the modifier `ok`, `warn`, or
           `danger`, or pick it from data with class:NAME guards. The host
           updates the number (and the text) as the work advances. -->
      <col class="k-meter">
        <row class="k-meter-head">
          <text class="k-meter-label">{meters.upload.label}</text>
          <spacer/>
          <text class="k-meter-value">{meters.upload.text}</text>
        </row>
        <progress class="k-meter-bar" bind="meters.upload.pct"/>
      </col>
      <col class="k-meter">
        <row class="k-meter-head">
          <text class="k-meter-label">Disk</text>
          <spacer/>
          <text class="k-meter-value">{meters.disk.text}</text>
        </row>
        <progress class="k-meter-bar" class:warn="meters.disk.warn" class:danger="meters.disk.crit" bind="meters.disk.pct"/>
      </col>
      <col class="k-meter">
        <row class="k-meter-head">
          <text class="k-meter-label">Tests</text>
          <spacer/>
          <text class="k-meter-value">{meters.tests.text}</text>
        </row>
        <progress class="k-meter-bar ok" bind="meters.tests.pct"/>
      </col>
    </col>
  </screen>
</tui>
