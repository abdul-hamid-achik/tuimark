<tui version="3" theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <keymap>
    <bind keys="ctrl+c,q" action="quit"/>
  </keymap>
  <screen id="demo" focus="#b-primary">
    <col width="1fr" height="1fr" gap="1" pad="1">
      <text class="title">button</text>
      <text class="subtitle">tab / shift+tab moves focus; enter or space presses</text>
      <!-- COPY: a button is `btn` plus a variant: primary, secondary, danger,
           ghost. `on:click` names the action; the host implements it.
           The focused button is drawn inverted (see `.btn:focus`). -->
      <row width="1fr" height="1" gap="2">
        <button id="b-primary" class="btn primary" label="Save" on:click="save"/>
        <button id="b-secondary" class="btn secondary" label="Cancel" on:click="cancel"/>
      </row>
      <row width="1fr" height="1" gap="2">
        <button id="b-danger" class="btn danger" label="Delete" on:click="delete"/>
        <button id="b-ghost" class="btn ghost" label="Skip" on:click="skip"/>
        <button id="b-off" class="btn secondary" label="Locked" disabled="true"/>
      </row>
      <text class="muted">last action: {last}</text>
    </col>
  </screen>
</tui>
