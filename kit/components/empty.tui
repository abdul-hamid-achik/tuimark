<!-- k-empty · Contract: reads empty.title, empty.text · Actions: empty_create · Keys: enter on the button · Requires: k-btn, k-title -->
<tui theme="auto">
  <style src="../theme.tcss"/>
  <style src="../kit.tcss"/>
  <screen id="demo" focus="#empty__create">
    <col width="1fr" height="1fr" pad="1">
      <text class="k-title">empty state</text>
      <!-- COPY: an empty state is a `col` with class `k-empty` (it fills the
           space left and centers its children), an icon, a title, one line
           of help, and the call to action (a button label is literal text).
           Show it with `if="!items.any"` next to the list it replaces. -->
      <col class="k-empty">
        <text class="k-empty-icon">◌</text>
        <text class="k-empty-title">{empty.title}</text>
        <text class="k-empty-text">{empty.text}</text>
        <button id="empty__create" class="k-btn primary" label="New deployment" on:click="empty_create"/>
      </col>
    </col>
  </screen>
</tui>
