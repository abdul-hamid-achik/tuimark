<!-- k-empty · Contract: with="PATH as e" reads e.icon, e.title, e.text, and e.action, the label of the call to action (no button without it) · Actions: empty_create · Keys: enter on the button · Requires: k-btn, k-title -->
<tui theme="auto">
  <include src="../kit.tui"/>
  <screen id="demo" focus="#empty__create">
    <col width="1fr" height="1fr" pad="1">
      <text class="k-title">empty state</text>
      <!-- USE: the k-empty template fills the space left and centers an
           icon, a title, one line of help, and an optional call to action
           (its label is e.action; leave it out for no button). The button
           is empty__create and fires empty_create. Show it with
           `if="!items.any"` on the <use>, next to the list it replaces. -->
      <use id="empty" template="k-empty" with="empty as e"/>
    </col>
  </screen>
</tui>
