<tui version="2">
  <style>
    .num { content-align: end; }
  </style>
  <screen id="main" focus="#t">
    <table id="t" each="rows as r" key="r.pid" bind="cur" gap="1">
      <column id="c-pid" class="num" title="PID" width="5">{r.pid}</column>
      <column id="c-name" title="Name" width="1fr">{r.name}</column>
      <column id="c-cpu" class="num" title="CPU%">{r.cpu}</column>
    </table>
  </screen>
</tui>
