{
  "name": "@thelacanians/tuimark",
  "version": "0.5.3",
  "description": "Tuimark for npm: the `tuimark` command (validate, dump, play, run terminal UIs written as .tui markup) and a TypeScript client to drive a view from Bun over `tuimark host`.",
  "type": "module",
  "license": "MIT",
  "author": "Abdul Hamid Achik",
  "homepage": "https://tuimark.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdul-hamid-achik/tuimark.git",
    "directory": "sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/abdul-hamid-achik/tuimark/issues"
  },
  "keywords": [
    "tuimark",
    "tui",
    "terminal",
    "cli",
    "ui",
    "markup",
    "declarative",
    "layout",
    "css",
    "agents",
    "ai-agents",
    "bun",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tuimark": "./bin/tuimark.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["bin", "dist", "src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
